{
  "name": "elvinlab.dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.browser.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=chromium-1280",
    "depcruise": "node apps/web/scripts/mirror-astro.ts && depcruise apps/web/boundaries-mirror/src packages/core/src",
    "new-post": "pnpm --filter web new-post",
    "test:white-label": "node apps/web/scripts/white-label-check.ts",
    "check:dev-cold-start": "node apps/web/scripts/dev-cold-start-check.ts",
    "docs:config": "node --import ./apps/web/scripts/register-alias.mjs apps/web/scripts/generate-config-docs.ts",
    "notify:note": "node --import ./apps/web/scripts/register-alias.mjs apps/web/scripts/notify-subscribers.ts",
    "stress:experiments": "node apps/web/scripts/stress-experiments.ts",
    "test:lighthouse": "node apps/web/scripts/run-lighthouse-ci.ts",
    "check:js-budget": "node apps/web/scripts/performance-budget.ts",
    "check:page-weight": "node apps/web/scripts/page-weight-budget.ts",
    "verify": "node apps/web/scripts/verify-scope.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
