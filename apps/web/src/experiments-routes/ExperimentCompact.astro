---
/**
 * One experiment of the compact tier of `/experiments/`: the cover only (no gallery, no thumbnails,
 * no radios), the mono index, the title with the status pill, a short description and at most two
 * tags. The whole card is one link: to the case note, else the live site, else the code; an entry
 * with none of them renders as a plain card. It carries the entry id as its anchor. Styles are
 * unscoped (`is:global`, every class is `xc-` prefixed) to save the scope attribute on each element,
 * about 28 bytes times 20 elements per card; Astro still bundles them only into pages that import this
 * component, so they ship on `/experiments/` only.
 */
import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import type { ExperimentEntry } from '@/features/portfolio/index.ts';
import { experimentTagLabel } from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { resolveExperimentImage } from '@/shared/lib/experiment-image.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';

type Props = { experiment: ExperimentEntry; locale: Locale; index: number };

const { experiment, locale, index } = Astro.props;
const cover = experiment.images?.[0];
const image = cover ? resolveExperimentImage(experiment.id, cover.file) : undefined;
const href = experiment.note
  ? localizePath(`/notes/${experiment.note}/`, experiment.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : (experiment.url ?? experiment.repo);
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, ...(experiment.note ? {} : externalLinkAttrs(href, site.url)) } : {};
const tags = experiment.tags.slice(0, 2);
---

<li id={experiment.id} class="xc">
  <Tag class="xc-body" {...linkProps}>
    <div class="xc-cover">
      {image && cover ? (
        <Image src={image} alt={pickLocale(cover.alt, locale, LOCALES.defaultLocale)} format="webp" quality={75} width={400} height={250} widths={[400]} sizes="(min-width: 1024px) 340px, (min-width: 640px) 45vw, calc(100vw - 3rem)" loading="lazy" decoding="async" />
      ) : (
        <span class="xc-slug" aria-hidden="true">{experiment.id}</span>
      )}
    </div>
    <div class="xc-meta">
      <span class="xc-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
      <span class="xc-status"><span class="xc-dot" data-status={experiment.status} aria-hidden="true"></span>{t(locale, `exp.status.${experiment.status}`)}</span>
    </div>
    <h4>{experiment.title}</h4>
    <p>{pickLocale(experiment.description, locale, LOCALES.defaultLocale)}</p>
    {tags.length > 0 && <ul>{tags.map((tag) => <li>{experimentTagLabel(tag)}</li>)}</ul>}
    {href && <svg class="xc-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 4h1v1H8zM7 3h1v3H7zM6 2h1v5H6zM5 1h1v7H5zM0 3h5v3H0z"></path></svg>}
  </Tag>
</li>

<style is:global>
  .xc {
    display: flex;
    min-width: 0;
    scroll-margin-top: 6rem;
  }
  .xc-body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
    padding: 1rem;
    border-radius: var(--radius-card);
    background: var(--color-card);
    outline: 1px solid var(--color-divider);
    outline-offset: -1px;
    color: inherit;
    text-decoration: none;
  }
  a.xc-body:hover {
    background: var(--color-card-hover);
  }
  a.xc-body:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  /* Cover: 16:10, square-capped pixel brackets that turn violet on hover and focus. */
  .xc-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-inner);
    background:
      linear-gradient(var(--color-divider) 1px, transparent 1px) 0 0 / 100% 2rem,
      linear-gradient(90deg, var(--color-divider) 1px, transparent 1px) 0 0 / 2rem 100%,
      var(--color-chip);
    outline: 1px solid var(--color-divider);
    outline-offset: -1px;
    color: color-mix(in srgb, var(--color-text) 38%, transparent);
  }
  .xc-cover::after {
    content: '';
    position: absolute;
    inset: 4px;
    pointer-events: none;
    background:
      linear-gradient(currentColor, currentColor) top left / 10px 3px no-repeat,
      linear-gradient(currentColor, currentColor) top left / 3px 10px no-repeat,
      linear-gradient(currentColor, currentColor) top right / 10px 3px no-repeat,
      linear-gradient(currentColor, currentColor) top right / 3px 10px no-repeat,
      linear-gradient(currentColor, currentColor) bottom left / 10px 3px no-repeat,
      linear-gradient(currentColor, currentColor) bottom left / 3px 10px no-repeat,
      linear-gradient(currentColor, currentColor) bottom right / 10px 3px no-repeat,
      linear-gradient(currentColor, currentColor) bottom right / 3px 10px no-repeat;
  }
  a.xc-body:focus-visible .xc-cover {
    color: var(--color-primary);
  }
  @media (hover: hover) {
    a.xc-body:hover .xc-cover {
      color: var(--color-primary);
    }
  }
  .xc-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .xc-slug {
    position: absolute;
    left: 0.75rem;
    bottom: 0.625rem;
    font: 400 0.9375rem / 1.3 var(--font-mono);
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }
  .xc-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .xc-index {
    font: 600 1.5rem / 1 var(--font-pixel);
    color: transparent;
    -webkit-text-stroke: 1px var(--color-divider);
  }
  .xc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  .xc-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-primary);
  }
  .xc-dot[data-status='running'] {
    background: var(--color-ok);
  }
  .xc-dot[data-status='archived'] {
    background: var(--color-muted);
  }
  .xc-body h4 {
    margin: 0;
    font: 700 1.125rem / 1.2 var(--font-display);
    overflow-wrap: anywhere;
  }
  .xc-body p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .xc-body ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xc-body li {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  .xc-arrow {
    margin-top: auto;
    align-self: flex-end;
    color: var(--color-primary);
  }
  @media (prefers-reduced-motion: no-preference) {
    .xc-body {
      transition: background-color 150ms ease-out;
    }
    .xc-cover {
      transition: color 250ms ease-out;
    }
    .xc-arrow {
      transition: transform 150ms steps(2, end);
    }
    a.xc-body:hover .xc-arrow {
      transform: translateX(3px);
    }
  }
  @supports (content-visibility: auto) {
    .xc {
      content-visibility: auto;
      contain-intrinsic-size: auto 26rem;
    }
  }
</style>
