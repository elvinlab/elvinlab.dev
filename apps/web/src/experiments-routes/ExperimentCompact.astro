---
/**
 * One experiment of the compact list of `/experiments/`: a quiet card with the title, a short
 * description (two lines at most), at most two tags and a pixel arrow. A small 16:10 cover shows
 * only when the entry has a real image (no placeholder, no frame decoration); the status pill only
 * when the status is not `shipped`, so "Shipped" is not repeated on every card. The whole card is
 * one link named by its title (`aria-labelledby`): to the case note, else the live site, else the code; an entry with none of them renders
 * as a plain card. It carries the entry id as its anchor. Styles are unscoped (`is:global`, every
 * class is `xc-` prefixed) to save the scope attribute on each element; Astro still bundles them
 * only into pages that import this component, so they ship on `/experiments/` only.
 */
import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import type { ExperimentEntry } from '@/features/portfolio/index.ts';
import { experimentTagLabel } from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { resolveExperimentImage } from '@/shared/lib/experiment-image.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';

type Props = { experiment: ExperimentEntry; locale: Locale };

const { experiment, locale } = Astro.props;
const cover = experiment.images?.[0];
const image = cover ? resolveExperimentImage(experiment.id, cover.file) : undefined;
const href = experiment.note
  ? localizePath(`/notes/${experiment.note}/`, experiment.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : (experiment.url ?? experiment.repo);
const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, 'aria-labelledby': `${experiment.id}-t`, ...(experiment.note ? {} : externalLinkAttrs(href, site.url)) } : {};
const tags = experiment.tags.slice(0, 2);
---

<li id={experiment.id} class="xc">
  <Tag class="xc-body" {...linkProps}>
    <div class="xc-head">
      {image && cover && (
        <div class="xc-cover">
          <Image src={image} alt={pickLocale(cover.alt, locale, LOCALES.defaultLocale)} format="webp" quality={75} width={160} height={100} widths={[160, 320]} sizes="80px" loading="lazy" decoding="async" />
        </div>
      )}
      <div class="xc-title">
        <h3 id={`${experiment.id}-t`}>{experiment.title}</h3>
        {experiment.status !== 'shipped' && <span class="xc-status"><span class="xc-dot" data-status={experiment.status} aria-hidden="true"></span>{t(locale, `exp.status.${experiment.status}`)}</span>}
      </div>
    </div>
    <p>{pickLocale(experiment.description, locale, LOCALES.defaultLocale)}</p>
    {(tags.length > 0 || href) && (
      <div class="xc-foot">
        {tags.length > 0 && <ul>{tags.map((tag) => <li>{experimentTagLabel(tag)}</li>)}</ul>}
        {href && <svg class="xc-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 4h1v1H8zM7 3h1v3H7zM6 2h1v5H6zM5 1h1v7H5zM0 3h5v3H0z"></path></svg>}
      </div>
    )}
  </Tag>
</li>

<style is:global>
  .xc {
    display: flex;
    min-width: 0;
    scroll-margin-top: 6rem;
  }
  .xc-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
    padding: 1rem;
    border-radius: var(--radius-card);
    background: var(--color-card);
    outline: 1px solid transparent;
    outline-offset: -1px;
    color: inherit;
    text-decoration: none;
  }
  a.xc-body:hover {
    background: var(--color-card-hover);
    outline-color: var(--color-divider);
  }
  a.xc-body:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .xc-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  /* A small 16:10 cover, only for an entry with a real image. */
  .xc-cover {
    flex: 0 0 5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-inner);
    background: var(--color-chip);
  }
  .xc-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .xc-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    min-width: 0;
  }
  .xc-body h3 {
    margin: 0;
    font: 700 1.125rem / 1.2 var(--font-display);
    overflow-wrap: anywhere;
  }
  .xc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  .xc-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-primary);
  }
  .xc-dot[data-status='running'] {
    background: var(--color-ok);
  }
  .xc-dot[data-status='archived'] {
    background: var(--color-muted);
  }
  .xc-body p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .xc-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
  }
  .xc-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xc-foot li {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  .xc-arrow {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-muted);
  }
  a.xc-body:hover .xc-arrow,
  a.xc-body:focus-visible .xc-arrow {
    color: var(--color-primary);
  }
  @media (prefers-reduced-motion: no-preference) {
    .xc-body {
      transition: background-color 150ms ease-out, outline-color 150ms ease-out;
    }
    .xc-arrow {
      transition: transform 150ms steps(2, end), color 150ms ease-out;
    }
    a.xc-body:hover .xc-arrow {
      transform: translateX(3px);
    }
  }
  @supports (content-visibility: auto) {
    .xc {
      content-visibility: auto;
      contain-intrinsic-size: auto 9.5rem;
    }
  }
</style>
