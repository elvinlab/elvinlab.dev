---
/**
 * The `/experiments/` page for one locale: a lab-style header (title, intro, decorative comment
 * stack) and every experiment as an exhibition piece, separated by dashed dividers with a mono
 * label. Styles are scoped here and in the piece and media components, so none of them reaches `/me`.
 */

import { localizePath } from '@elvinlab/core';

import {
  experimentsPagePath,
  experimentsSettings,
  introText,
  labWords,
  loadExperiments,
  paginateExperiments,
} from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import BaseLayout from '@/shared/layout/BaseLayout.astro';

import ExperimentCompact from './ExperimentCompact.astro';
import ExperimentPiece from './ExperimentPiece.astro';
import ExperimentsPager from './ExperimentsPager.astro';

type Props = { locale: Locale; page?: number };

const { locale, page = 1 } = Astro.props;
const experiments = await loadExperiments();
const { perPage, meRows } = experimentsSettings;
const pages = paginateExperiments(experiments, { perPage, pinFirst: meRows });
const current = pages.find((candidate) => candidate.page === page);
if (!current) throw new Error(`/experiments/ has no page ${page} (${pages.length} in total)`);
const { big, groups } = current;
const total = String(big.length).padStart(2, '0');
const hasMore = groups.length > 0;
const paged = page > 1;
const pageUrl = (target: number): string =>
  new URL(localizePath(experimentsPagePath(target), locale, LOCALES), site.url).href;
const title = paged ? t(locale, 'experiments.page.title', { page }) : t(locale, 'experiments.title');
const description = paged
  ? t(locale, 'experiments.page.description', { page, pages: pages.length })
  : t(locale, 'experiments.description');
const intro = introText(site.experiments.intro, locale, LOCALES.defaultLocale, t(locale, 'experiments.intro'));
const labKeys = [1, 2, 3, 4] as const;
const lab = labWords(
  site.experiments.words,
  locale,
  LOCALES.defaultLocale,
  labKeys.map((n) => t(locale, `experiments.lab.${n}`)),
);
---

<BaseLayout locale={locale} path={experimentsPagePath(page)} title={title} description={description}>
  {paged && <link slot="head" rel="prev" href={pageUrl(page - 1)} />}
  {page < pages.length && <link slot="head" rel="next" href={pageUrl(page + 1)} />}
  <section class="xp-page">
    <header class="xp-header">
      <div class="xp-header-text">
        <h1>
          <svg class="xp-flask" viewBox="0 0 9 9" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><rect x="2" y="0" width="5" height="1"></rect><rect x="3" y="1" width="1" height="3"></rect><rect x="5" y="1" width="1" height="3"></rect><rect x="2" y="4" width="1" height="1"></rect><rect x="6" y="4" width="1" height="1"></rect><rect x="1" y="5" width="1" height="3"></rect><rect x="7" y="5" width="1" height="3"></rect><rect x="2" y="6" width="5" height="2"></rect><rect x="1" y="8" width="7" height="1"></rect></svg>{t(locale, 'experiments.title')}
        </h1>
        <p>{intro}</p>
        {paged && <p class="xp-pagestatus">{t(locale, 'experiments.page.status', { page, pages: pages.length })}</p>}
      </div>
      <ul class="xp-lab" aria-hidden="true">
        {lab.map((word) => <li>{word}</li>)}
      </ul>
    </header>
    {experiments.length === 0 ? (
      <p class="xp-empty">{t(locale, 'experiments.empty')}</p>
    ) : (
      big.length > 0 && <div class="xp-list">
        {big.map((experiment, i) => (
          <>
            {i > 0 && (
              <div class="xp-divider" aria-hidden="true">
                <span>{String(i + 1).padStart(2, '0')} / {total}</span>
              </div>
            )}
            <ExperimentPiece experiment={experiment} locale={locale} index={i + 1} />
          </>
        ))}
      </div>
    )}
    {hasMore && (
      <section class="xp-more" aria-labelledby="xp-more-title">
        <h2 id="xp-more-title" class="xp-rule">{t(locale, 'experiments.more')}</h2>
        {groups.map(({ year, entries }) => (
          <div class="xp-year">
            <h3 class="xp-rule">{year}</h3>
            <ul class="xp-grid">
              {entries.map(({ entry, index }) => <ExperimentCompact experiment={entry} locale={locale} index={index} />)}
            </ul>
          </div>
        ))}
      </section>
    )}
    <ExperimentsPager locale={locale} page={page} pages={pages.length} />
  </section>
</BaseLayout>

<style>
  .xp-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .xp-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--color-divider);
  }
  /* Same size, weight and tracking as the title of the other pages (`text-3xl font-bold tracking-tight`). */
  .xp-header-text h1 {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 2.25rem;
    letter-spacing: -0.025em;
  }
  .xp-header-text .xp-pagestatus {
    margin-top: 0.375rem;
    font: 400 0.9375rem / 1.3 var(--font-mono);
    color: var(--color-muted);
  }
  .xp-header-text p {
    max-width: 60ch;
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  /* The pixel flask before the title: the single pink accent of the header, a 9 x 9 grid with crisp edges. */
  .xp-flask {
    flex-shrink: 0;
    width: 27px;
    height: 27px;
    color: var(--color-pink);
    shape-rendering: crispEdges;
  }
  .xp-lab {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 400 0.8125rem / 1.35 var(--font-mono);
    color: var(--color-muted);
    user-select: none;
  }
  .xp-lab li:nth-child(odd) {
    color: color-mix(in srgb, var(--color-muted) 70%, var(--color-primary));
  }
  @media (min-width: 768px) {
    .xp-lab {
      display: block;
      flex-shrink: 0;
      text-align: right;
    }
  }
  .xp-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .xp-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    font: 400 0.8125rem / 1 var(--font-mono);
    color: var(--color-muted);
  }
  /* Square dashes (8 px on, 8 px off, 2 px tall) instead of a dashed border, which renders round. */
  .xp-divider::before,
  .xp-divider::after {
    content: '';
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--color-divider) 0 8px, transparent 8px 16px);
  }
  .xp-more {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .xp-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
  }
  .xp-rule::after {
    content: '';
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--color-divider) 0 8px, transparent 8px 16px);
  }
  h2.xp-rule {
    font: 700 1.5rem / 1.2 var(--font-display);
  }
  h3.xp-rule {
    font: 400 0.9375rem / 1 var(--font-mono);
    color: var(--color-muted);
  }
  .xp-year {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .xp-grid {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .xp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .xp-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .xp-empty {
    color: var(--color-text-secondary);
  }
</style>
