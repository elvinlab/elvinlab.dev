---
/**
 * The pager of `/experiments/` from page 2 onwards (it never renders while there is one page): real
 * links only, Previous and Next at the ends, numbered links in between (a window with an ellipsis
 * beyond seven pages) and the current page as plain text with `aria-current="page"`. Styles are
 * scoped here, so none of them reaches `/me`.
 */
import { localizePath } from '@elvinlab/core';

import { experimentsPagePath, pagerItems } from '@/features/portfolio/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; page: number; pages: number };

const { locale, page, pages } = Astro.props;
const href = (target: number): string => localizePath(experimentsPagePath(target), locale, LOCALES);
const items = pagerItems(page, pages);
const arrow = 'M8 4h1v1H8zM7 3h1v3H7zM6 2h1v5H6zM5 1h1v7H5zM0 3h5v3H0z';
---

{pages > 1 && (
  <nav class="xp-pager" aria-label={t(locale, 'experiments.pager.label')}>
    {page > 1 && (
      <a class="xp-pager-step xp-pager-prev" href={href(page - 1)} rel="prev">
        <svg class="xp-pager-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
        {t(locale, 'experiments.pager.prev')}
      </a>
    )}
    <ul class="xp-pager-pages">
      {items.map((item) => (
        <li>
          {item.kind === 'ellipsis' ? (
            <span class="xp-pager-gap" aria-hidden="true">…</span>
          ) : item.page === page ? (
            <span class="xp-pager-num xp-pager-current" aria-current="page">{item.page}</span>
          ) : (
            <a class="xp-pager-num" href={href(item.page)} aria-label={t(locale, 'experiments.pager.goto', { page: item.page })}>{item.page}</a>
          )}
        </li>
      ))}
    </ul>
    {page < pages && (
      <a class="xp-pager-step xp-pager-next" href={href(page + 1)} rel="next">
        {t(locale, 'experiments.pager.next')}
        <svg class="xp-pager-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
      </a>
    )}
  </nav>
)}

<style>
  /* Square dashes like the dividers of the page: 8 px on, 8 px off, 2 px tall. */
  .xp-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1.5rem;
    background: repeating-linear-gradient(90deg, var(--color-divider) 0 8px, transparent 8px 16px) top / 100% 2px no-repeat;
  }
  .xp-pager-pages {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    grid-column: 1 / -1;
    grid-row: 1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp-pager-prev {
    grid-column: 1;
    grid-row: 2;
    justify-self: start;
  }
  .xp-pager-next {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }
  @media (min-width: 640px) {
    .xp-pager {
      grid-template-columns: 1fr auto 1fr;
    }
    .xp-pager-pages {
      grid-column: 2;
      grid-row: 1;
    }
    .xp-pager-prev {
      grid-column: 1;
      grid-row: 1;
    }
    .xp-pager-next {
      grid-column: 3;
      grid-row: 1;
    }
  }
  .xp-pager-num,
  .xp-pager-gap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    font: 400 0.9375rem / 1 var(--font-mono);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .xp-pager-gap {
    color: var(--color-muted);
  }
  a.xp-pager-num,
  .xp-pager-step {
    border-radius: var(--radius-inner);
    outline: 1px solid var(--color-divider);
    outline-offset: -1px;
    transition: color 150ms, background-color 150ms;
  }
  .xp-pager-step {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.875rem;
    font: 400 0.9375rem / 1 var(--font-mono);
    color: var(--color-text-secondary);
    text-decoration: none;
  }
  .xp-pager-prev .xp-pager-arrow {
    transform: scaleX(-1);
  }
  @media (hover: hover) {
    a.xp-pager-num:hover,
    .xp-pager-step:hover {
      color: var(--color-primary);
      background: var(--color-card-hover);
    }
  }
  a.xp-pager-num:focus-visible,
  .xp-pager-step:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  /* The current page: bold text with a square pink marker above it, no outline (it is not a link). */
  .xp-pager-current {
    font-weight: 700;
    color: var(--color-text);
  }
  .xp-pager-current::before {
    content: '';
    position: absolute;
    top: 0.25rem;
    left: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    background: var(--color-pink);
  }
</style>
