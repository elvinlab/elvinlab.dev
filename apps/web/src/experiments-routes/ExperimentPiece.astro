---
/**
 * One experiment as an exhibition piece of `/experiments/`: the media frame (gallery or single
 * figure) next to a text panel with the status, the title, the three short facts (problem, my part,
 * result), up to three tags and the actions. On `lg` the two sit in columns and the media side
 * alternates per piece; below `lg` the media comes first. An entry without an image has no media
 * column at all: it is a single-column panel (no fake image). The piece carries the entry id as its
 * anchor, which the compact rows on `/me` link to. Its CSS is emitted once by `ExperimentsPage.astro`
 * through `experiment-styles.ts`, so it ships on `/experiments/` only.
 */
import { localizePath } from '@elvinlab/core';

import type { ExperimentEntry } from '@/features/portfolio/index.ts';
import { caseLinkLabelKey, experimentTagLabel, visibleExperimentTags } from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

import ExperimentMedia from './ExperimentMedia.astro';

type Props = {
  experiment: ExperimentEntry;
  locale: Locale;
  /** 1-based position on the page: it decides which side the media sits on and which piece is first. */
  index: number;
};

const { experiment, locale, index } = Astro.props;
const text = (value: ExperimentEntry['subtitle']) => pickLocale(value, locale, LOCALES.defaultLocale);
const subtitle = text(experiment.subtitle);
type FactKey = 'experiment.problem' | 'experiment.contribution' | 'experiment.result';
const facts = (
  [
    ['experiment.problem', text(experiment.problem)],
    ['experiment.contribution', text(experiment.contribution)],
    ['experiment.result', text(experiment.result)],
  ] satisfies (readonly [FactKey, string])[]
).filter(([, value]) => value !== '');
const hasMedia = (experiment.images?.length ?? 0) > 0;
const description = text(experiment.description);
const caseHref = experiment.note
  ? localizePath(`/notes/${experiment.note}/`, experiment.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : undefined;
const tags = visibleExperimentTags(experiment.tags);
const first = index === 1;
---

<article id={experiment.id} class="xp-piece" data-flip={hasMedia && index % 2 === 0 ? '' : undefined} data-first={first ? '' : undefined} data-featured={hasMedia && first && experiment.featured ? '' : undefined} data-solo={hasMedia ? undefined : ''}>
  {hasMedia && <ExperimentMedia experiment={experiment} locale={locale} priority={first} />}
  <div class="xp-panel">
    <div class="xp-top">
      <span class="xp-status">
        <span class="xp-dot" data-status={experiment.status} aria-hidden="true"></span>
        {t(locale, `exp.status.${experiment.status}`)}
      </span>
    </div>
    <div class="xp-heading">
      <h2>{experiment.title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    {facts.length > 0 ? (
      <dl class="xp-facts">
        {facts.map(([key, value]) => (
          <div>
            <dt>{t(locale, key)}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="xp-description">{description}</p>
    )}
    {tags.length > 0 && (
      <ul class="xp-tags">
        {tags.map((tag) => <li>{experimentTagLabel(tag)}</li>)}
      </ul>
    )}
    {(experiment.url || caseHref || experiment.repo) && (
      <div class="xp-actions print:hidden">
        {caseHref && (
          <a href={caseHref} class="xp-btn">{t(locale, caseLinkLabelKey(locale, experiment.noteLang ?? LOCALES.defaultLocale))}<svg class="xp-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><rect x="8" y="4" width="1" height="1"></rect><rect x="7" y="3" width="1" height="3"></rect><rect x="6" y="2" width="1" height="5"></rect><rect x="5" y="1" width="1" height="7"></rect><rect x="0" y="3" width="5" height="3"></rect></svg></a>
        )}
        {experiment.url && (
          <a href={experiment.url} {...externalLinkAttrs(experiment.url, site.url)} class="xp-link">{t(locale, 'experiment.live')}<ExternalHint href={experiment.url} locale={locale} /></a>
        )}
        {experiment.repo && (
          <a href={experiment.repo} {...externalLinkAttrs(experiment.repo, site.url)} class="xp-link">{t(locale, 'experiment.code')}<ExternalHint href={experiment.repo} locale={locale} /></a>
        )}
      </div>
    )}
  </div>
</article>

