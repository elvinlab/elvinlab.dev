---
/**
 * One experiment as an exhibition piece of `/experiments/`: the media frame (gallery, single figure
 * or typographic cover) next to a text panel with the status, the title, the three short facts
 * (problem, my part, result), up to three tags and the actions. On `lg` the two sit in columns and
 * the media side alternates per piece; below `lg` the media comes first. The piece carries the entry
 * id as its anchor, which the compact rows on `/me` link to. Styles are scoped to this component and
 * ship on `/experiments/` only.
 */
import { localizePath } from '@elvinlab/core';

import type { ExperimentEntry } from '@/features/portfolio/index.ts';
import { caseLinkLabelKey, experimentTagLabel, visibleExperimentTags } from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

import ExperimentMedia from './ExperimentMedia.astro';

type Props = {
  experiment: ExperimentEntry;
  locale: Locale;
  /** 1-based position on the page: it shows as the big mono index and decides which side the media sits on. */
  index: number;
};

const { experiment, locale, index } = Astro.props;
const text = (value: ExperimentEntry['subtitle']) => pickLocale(value, locale, LOCALES.defaultLocale);
const subtitle = text(experiment.subtitle);
type FactKey = 'experiment.problem' | 'experiment.contribution' | 'experiment.result';
const facts = (
  [
    ['experiment.problem', 'flask', text(experiment.problem)],
    ['experiment.contribution', 'code', text(experiment.contribution)],
    ['experiment.result', 'spark', text(experiment.result)],
  ] satisfies (readonly [FactKey, string, string])[]
).filter(([, , value]) => value !== '');
const description = text(experiment.description);
const caseHref = experiment.note
  ? localizePath(`/notes/${experiment.note}/`, experiment.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : undefined;
const tags = visibleExperimentTags(experiment.tags);
const first = index === 1;
---

<article id={experiment.id} class="xp-piece" data-flip={index % 2 === 0 ? '' : undefined} data-first={first ? '' : undefined} data-featured={first && experiment.featured ? '' : undefined}>
  <ExperimentMedia experiment={experiment} locale={locale} priority={first} />
  <div class="xp-panel">
    <div class="xp-top">
      <span class="xp-status">
        <span class="xp-dot" data-status={experiment.status} aria-hidden="true"></span>
        {t(locale, `exp.status.${experiment.status}`)}
      </span>
      <span class="xp-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    </div>
    <div class="xp-heading">
      <h2>{experiment.title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    {facts.length > 0 ? (
      <dl class="xp-facts">
        {facts.map(([key, icon, value]) => (
          <div>
            <dt><SocialIcon name={icon} />{t(locale, key)}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <p class="xp-description">{description}</p>
    )}
    {tags.length > 0 && (
      <ul class="xp-tags">
        {tags.map((tag) => <li>{experimentTagLabel(tag)}</li>)}
      </ul>
    )}
    {(experiment.url || caseHref || experiment.repo) && (
      <div class="xp-actions print:hidden">
        {caseHref && (
          <a href={caseHref} class="xp-btn">{t(locale, caseLinkLabelKey(locale, experiment.noteLang ?? LOCALES.defaultLocale))}<svg class="xp-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><rect x="8" y="4" width="1" height="1"></rect><rect x="7" y="3" width="1" height="3"></rect><rect x="6" y="2" width="1" height="5"></rect><rect x="5" y="1" width="1" height="7"></rect><rect x="0" y="3" width="5" height="3"></rect></svg></a>
        )}
        {experiment.url && (
          <a href={experiment.url} {...externalLinkAttrs(experiment.url, site.url)} class="xp-link">{t(locale, 'experiment.live')}<ExternalHint href={experiment.url} locale={locale} /></a>
        )}
        {experiment.repo && (
          <a href={experiment.repo} {...externalLinkAttrs(experiment.repo, site.url)} class="xp-link">{t(locale, 'experiment.code')}<ExternalHint href={experiment.repo} locale={locale} /></a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .xp-piece {
    position: relative;
    display: grid;
    gap: 1.75rem;
    /* Room for the brackets and glow that hang outside the media: content-visibility clips to the box. */
    padding: 0.75rem;
    margin: -0.75rem;
    scroll-margin-top: 5.25rem;
  }
  @supports (content-visibility: auto) {
    .xp-piece:not([data-first]) {
      content-visibility: auto;
      contain-intrinsic-size: auto 46rem;
    }
  }
  @media (min-width: 1024px) {
    .xp-piece {
      grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
      align-items: center;
      gap: 3rem;
    }
    .xp-piece[data-flip] {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    }
    .xp-piece[data-flip] > :global(.xp-media) {
      order: 2;
    }
  }

  /*
   * Soft glow behind the featured media: violet and cyan tokens, no blur filter, so it costs one
   * paint. A 2 px checkerboard in the page color is masked to a ring over the glow, so its edge
   * steps like an 8-bit gradient; it is almost invisible in the light theme.
   */
  .xp-piece[data-featured] > :global(.xp-media)::before {
    content: '';
    position: absolute;
    inset: -10% 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 65% at 25% 35%, var(--color-glow-violet), transparent 70%),
      radial-gradient(55% 60% at 80% 75%, var(--color-glow-cyan), transparent 70%);
    /* Fades to nothing before the layer's own edge, so no rectangle is ever visible. */
    mask-image: radial-gradient(closest-side at 50% 50%, black 45%, transparent 100%);
  }

  .xp-piece[data-featured] > :global(.xp-media)::after {
    content: '';
    position: absolute;
    inset: -10% 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-conic-gradient(var(--color-page) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    opacity: 0.3;
    mask-image: radial-gradient(closest-side at 50% 50%, transparent 55%, black 80%, transparent 100%);
  }
  :global([data-theme='elvinlab-light']) .xp-piece[data-featured] > :global(.xp-media)::after {
    opacity: 0.08;
  }

  .xp-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-card);
    outline: 1px solid var(--color-divider);
    outline-offset: -1px;
  }
  .xp-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .xp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  /* Square 8 x 8 status dot: no radius, like the other pixel details. */
  .xp-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-primary);
  }
  .xp-dot[data-status='running'] {
    background: var(--color-ok);
  }
  .xp-dot[data-status='archived'] {
    background: var(--color-muted);
  }
  /* Big outline numeral in the pixel display face (short and large: its allowed use); decorative and hollow. */
  .xp-index {
    margin-top: -0.25rem;
    font: 600 3.5rem / 1 var(--font-pixel);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-divider);
    user-select: none;
  }
  .xp-heading h2 {
    margin: 0;
    font: 700 1.75rem / 1.15 var(--font-display);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .xp-heading p {
    margin: 0.375rem 0 0;
    color: var(--color-muted);
  }
  .xp-facts {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: 0;
  }
  .xp-facts dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-muted);
  }
  .xp-facts dt :global(svg) {
    color: var(--color-primary);
  }
  .xp-facts dd {
    margin: 0.125rem 0 0;
    padding-left: 1.625rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }
  .xp-description {
    margin: 0;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .xp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .xp-tags li {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font: 400 0.8125rem / 1.125rem var(--font-mono);
    color: var(--color-text-secondary);
  }
  .xp-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: auto;
  }
  .xp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    border-radius: var(--radius-control);
    background: var(--color-button);
    color: white;
    font-weight: 500;
    text-decoration: none;
  }
  .xp-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-control);
    color: var(--color-primary);
    font-size: 0.875rem;
    text-decoration: underline dashed;
    text-underline-offset: 4px;
  }
  .xp-link:hover {
    background: var(--color-card-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .xp-btn {
      transition: transform 150ms ease-out, opacity 150ms ease-out;
    }
    .xp-btn:active {
      transform: scale(0.96);
    }
    .xp-link {
      transition: background-color 150ms ease-out;
    }
  }
  .xp-btn:hover {
    opacity: 0.9;
  }

  /*
   * Scroll reveal for the pieces after the first one: progressive enhancement only. Without
   * scroll-driven animation or with reduced motion nothing runs and the piece is simply there. It
   * only moves (transform, never opacity: a dimmed piece fails contrast checks and screenshots), so
   * a stalled animation leaves fully readable content.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .xp-piece:not([data-first]) {
        animation: xp-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 30%;
      }
    }
  }
  @keyframes xp-rise {
    from {
      transform: translateY(24px);
    }
    to {
      transform: none;
    }
  }
</style>
