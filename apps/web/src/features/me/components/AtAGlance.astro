---
/** The "at a glance" block: derived years fact plus configured facts, as quiet flat rows separated by dashed
 * hairlines (no box, no big numerals). Location, languages, work mode and availability live in `QuickFacts`,
 * so they are not repeated here. */

import { yearsSince } from '@/features/portfolio/index.ts';
import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const facts = [
  {
    value: t(locale, 'recruiter.years', { years: yearsSince(site.identity.startedYear) }),
    label: t(locale, 'me.yearsLabel', { year: site.identity.startedYear }),
  },
  ...site.me.facts.map((fact) => ({ value: fact.value[locale], label: fact.label[locale] })),
];
---

<section aria-label={t(locale, 'me.atAGlance')}>
  <dl class="flex flex-col divide-y divide-dashed divide-divider">
    {facts.map((fact) => (
      <div class="flex flex-col gap-0.5 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:gap-3">
        <dd class="order-1 font-medium">{fact.value}</dd>
        <dt class="order-2 text-text-secondary">{fact.label}</dt>
      </div>
    ))}
  </dl>
</section>
