---
/** /me hero: portrait (`identity.photo`, else the avatar) or initials, greeting, name, headline (`me.headline`, else
 * `identity.role`), the optional pitch and the call-to-action row: contact is primary, the CV and the social
 * links (icon plus visible name) are secondary. */

import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import { isEnabled, resolveCvUrl, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { resolvePhoto } from '@/shared/lib/avatar.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = { locale: Locale; showProjects?: boolean };

const { locale, showProjects = false } = Astro.props;
const photo = resolvePhoto(site.identity);
const cvUrl = resolveCvUrl(site.recruiter.cvUrl, locale, LOCALES.defaultLocale);
const initials = site.identity.name.split(' ').slice(0, 2).map((p) => p[0]).join('');
const contactHref = localizePath('/contact/', locale, LOCALES);
const headline = site.me.headline?.[locale] ?? site.identity.role[locale];
const pitch = site.me.pitch?.[locale];

const CTA = 'flex h-12 items-center gap-2 rounded-control px-5 font-medium active:scale-96';
const PRIMARY = `${CTA} bg-button text-white`;
const SECONDARY = `${CTA} bg-chip transition-colors duration-150 hover:bg-card-hover`;
// Contact leads; without the contact feature the CV (when set) takes the primary style.
const contactEnabled = isEnabled('contact');
---

<section class="grid gap-8 md:grid-cols-[232px_1fr] md:items-center">
  <div class="grid aspect-square w-40 place-items-center justify-self-start rounded-card bg-card p-2 md:w-[232px]">
    {photo ? (
      // Eager and high priority: the portrait is in the first viewport of /me and is its LCP element.
      // The slot is 160 px (phone) to 232 px (desktop) wide, so the source is resized to 2x of the
      // widest slot (2:3 portrait) instead of shipping the full-size photo.
      <Image
        src={photo}
        alt={site.identity.name}
        format="webp"
        quality={80}
        width={464}
        height={696}
        widths={[320, 464]}
        sizes="(min-width: 768px) 232px, 160px"
        loading="eager"
        fetchpriority="high"
        class="size-full rounded-inner object-cover object-top outline outline-1 -outline-offset-1 outline-divider"
      />
    ) : (
      <div class="grid size-full place-items-center rounded-inner bg-chip font-display text-5xl font-bold text-primary outline outline-1 -outline-offset-1 outline-divider" aria-hidden="true">{initials}</div>
    )}
  </div>
  <div class="flex flex-col gap-4">
    <p class="font-mono text-sm text-cyan">{t(locale, 'me.hello')}</p>
    <h1 class="font-display text-4xl font-bold leading-none tracking-tight md:text-6xl">
      {site.identity.name}<span aria-hidden="true" class="ml-1 inline-block h-3 w-2 bg-pink align-baseline md:h-4"></span>
    </h1>
    <p class="text-xl text-text-secondary text-balance md:text-2xl">{headline}</p>
    {pitch && <p class="max-w-[60ch] text-base leading-relaxed text-text-secondary text-pretty md:text-lg">{pitch}</p>}
    <div class="mt-1 flex flex-wrap gap-2.5 print:hidden">
      {contactEnabled && (
        <a href={contactHref} class={PRIMARY}>
          <SocialIcon name="mail" />{t(locale, 'me.contactMe')}
        </a>
      )}
      {showProjects && (
        <a href="#projects" class={SECONDARY}>{t(locale, 'me.viewProjects')}</a>
      )}
      {cvUrl && (
        <a href={cvUrl} {...externalLinkAttrs(cvUrl, site.url)} class={contactEnabled ? SECONDARY : PRIMARY}>
          <SocialIcon name="file" />{t(locale, 'me.cv')}<ExternalHint href={cvUrl} locale={locale} />
        </a>
      )}
      {site.socials.map((social) => (
        <a href={social.url} {...externalLinkAttrs(social.url, site.url, 'me')} class={SECONDARY}>
          <SocialIcon name={social.icon} />{social.label}<ExternalHint href={social.url} locale={locale} />
        </a>
      ))}
    </div>

    {/* Interactive buttons above are useless on paper; print the reachable URLs as text instead. */}
    <dl class="mt-1 hidden gap-x-3 text-sm print:grid print:grid-cols-[auto_1fr]">
      {contactEnabled && (
        <>
          <dt class="text-muted">{t(locale, 'me.contactMe')}</dt>
          <dd>{site.url}{contactHref}</dd>
        </>
      )}
      {cvUrl && (
        <>
          <dt class="text-muted">{t(locale, 'me.cv')}</dt>
          <dd>{cvUrl}</dd>
        </>
      )}
      {site.socials.map((social) => (
        <>
          <dt class="text-muted">{social.label}</dt>
          <dd>{social.url}</dd>
        </>
      ))}
    </dl>
  </div>
</section>
