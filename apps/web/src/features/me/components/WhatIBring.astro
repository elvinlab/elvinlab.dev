---
/** "What I bring": an intro paragraph and the configured strengths as a plain list, each a bold lead-in
 * followed by its text. No icons, no tiles. */

import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<section class="flex flex-col gap-5 border-t border-dashed border-divider pt-10">
  <SectionHeading text={t(locale, 'me.whatIBring')} />
  <p class="max-w-[70ch] text-[17px] leading-relaxed text-text-secondary">{site.me.intro[locale]}</p>
  <ul class="flex list-none flex-col gap-4">
    {site.me.strengths.map((s) => (
      <li class="max-w-[70ch] leading-relaxed">
        <strong class="font-bold">{s.title[locale]}.</strong> <span class="text-text-secondary">{s.body[locale]}</span>
      </li>
    ))}
  </ul>
</section>
