---
/** "What I bring": an intro paragraph and the configured strength tiles. */

import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Card from '@/shared/ui/Card.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
// Minimal stroke icons keyed by the config `icon` name.
const icons: Record<string, string> = {
  layers: 'm12 2 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 17l9 5 9-5',
  bot: 'M12 8V4m0 0H8m4 0h4M5 8h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2Zm4 5h.01M15 13h.01',
  gauge: 'M12 14 8 8m13 5a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
};
---

<Card as="section" class="flex flex-col gap-5 !p-7 md:!px-9">
  <SectionHeading text={t(locale, 'me.whatIBring')} />
  <p class="max-w-[70ch] text-[17px] leading-relaxed text-text-secondary">{site.me.intro[locale]}</p>
  <div class="grid gap-3 sm:grid-cols-3">
    {site.me.strengths.map((s) => (
      <div class="flex flex-col gap-2 rounded-inner bg-chip p-4">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.icon] ?? icons['layers']}></path></svg>
        <h3 class="text-base font-bold">{s.title[locale]}</h3>
        <p class="text-sm leading-relaxed text-text-secondary">{s.body[locale]}</p>
      </div>
    ))}
  </div>
</Card>
