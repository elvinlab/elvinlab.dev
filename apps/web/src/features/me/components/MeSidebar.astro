---
/** /me sidebar: quick facts (`lg+` only; below `lg` they sit under the hero), tech stack and a
 * "let's talk" card. Stack groups and the contact card carry an icon and a hover/focus explanation. */
import { localizePath } from '@elvinlab/core';

import QuickFacts from '@/features/me/components/QuickFacts.astro';
import StackGroup from '@/features/me/components/StackGroup.astro';
import { isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import InfoTip from '@/shared/ui/InfoTip.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const contactHref = localizePath('/contact/', locale, LOCALES);
// Groups flagged `layer` form a numbered path from data to screen; the rest cut across it (AI, quality, projects).
const groups = site.me.stack.map((group, index) => ({ group, index }));
const layers = groups.filter(({ group }) => group.layer);
const others = groups.filter(({ group }) => !group.layer && !group.folded);
const folded = groups.filter(({ group }) => !group.layer && group.folded);
---

<div class="flex flex-col gap-4 lg:sticky lg:top-4">
  <QuickFacts locale={locale} idPrefix="qf-side" class="hidden lg:flex" />

  <section class="tip-card flex flex-col gap-3 rounded-card bg-card p-5">
    <h2 class="font-display text-base font-bold">{t(locale, 'me.stack')}</h2>
    {layers.length > 0 && (
      <ol class="flex flex-col" aria-label={t(locale, 'me.stack.layers')}>
        {layers.map(({ group, index }, position) => (
          <li class="grid grid-cols-[1.75rem_1fr] gap-x-3">
            <div class="flex flex-col items-center" aria-hidden="true">
              <span class="grid size-7 shrink-0 place-items-center rounded-control bg-chip font-mono text-meta font-medium text-primary">{String(position + 1).padStart(2, '0')}</span>
              {position < layers.length - 1 && <span class="my-1 w-px flex-1 border-l border-dashed border-divider"></span>}
            </div>
            <div class:list={['flex flex-col gap-1.5', position < layers.length - 1 && 'pb-4']}>
              <StackGroup group={group} index={index} locale={locale} />
            </div>
          </li>
        ))}
      </ol>
    )}
    {others.map(({ group, index }, position) => (
      <div class:list={['flex flex-col gap-1.5', position === 0 && layers.length > 0 && 'border-t border-dashed border-divider pt-3']}>
        <StackGroup group={group} index={index} locale={locale} />
      </div>
    ))}
    {folded.length > 0 && (
      <details class="group border-t border-dashed border-divider pt-3 print:open">
        <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 font-mono text-meta font-medium text-primary marker:hidden print:hidden">
          <SocialIcon name="arrow-right" />{t(locale, 'me.stack.more')}
        </summary>
        <div class="mt-3 flex flex-col gap-4">
          {folded.map(({ group, index }) => (
            <div class="flex flex-col gap-1.5"><StackGroup group={group} index={index} locale={locale} /></div>
          ))}
        </div>
      </details>
    )}
  </section>

  {isEnabled('contact') && (
    <section class="tip-card flex flex-col gap-3 rounded-card bg-card bg-[length:100%_3px] bg-no-repeat p-5 bg-gradient-to-r from-primary via-cyan to-pink print:hidden">
      <h2 class="font-display text-base font-bold">
        <InfoTip id="contact-tip" text={t(locale, 'me.tip.contact')} place="up"><SocialIcon name="mail" />{t(locale, 'me.letsTalk.title')}</InfoTip>
      </h2>
      <p class="text-sm text-text-secondary">{t(locale, 'me.letsTalk.body')}</p>
      <a href={contactHref} class="flex h-11 items-center justify-center rounded-control bg-button px-4 font-medium text-white active:scale-96">{t(locale, 'me.contactMe')}</a>
    </section>
  )}
</div>
