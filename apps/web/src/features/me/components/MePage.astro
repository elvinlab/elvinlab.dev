---
/** The full `/me` recruiter page for one locale: hero, at-a-glance, what I bring, experience,
 * latest experiments and notes, certificates by year, and a sidebar. Print-friendly. */
import { getCollection } from 'astro:content';
import { localizePath } from '@elvinlab/core';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import { CertificatesByYear } from '@/features/credentials/index.ts';
import AtAGlance from '@/features/me/components/AtAGlance.astro';
import ExperienceTimeline from '@/features/me/components/ExperienceTimeline.astro';
import MeHero from '@/features/me/components/MeHero.astro';
import MeSidebar from '@/features/me/components/MeSidebar.astro';
import WhatIBring from '@/features/me/components/WhatIBring.astro';
import { hasPublishedNotes, NoteIndexRow, sortNotes } from '@/features/notes/index.ts';
import { ExperimentTile, sortExperiments } from '@/features/portfolio/index.ts';
import { isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import Card from '@/shared/ui/Card.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;

const experience = (await getCollection('experience')).map((entry) => entry.data);
const credentials = isEnabled('credentials') ? (await getCollection('credentials')).map((c) => c.data) : [];
const experiments = isEnabled('experiments')
  ? sortExperiments(await getCollection('experiments')).slice(0, 2).map((e) => e.data)
  : [];
const noteEntries = isEnabled('blog') ? await getCollection('notes') : [];
const allNotes = sortNotes(noteEntries.map((n) => ({ slug: n.id, data: n.data })));
const notes = allNotes.slice(0, 3);
const hasNotes = hasPublishedNotes(allNotes);
---

<BaseLayout locale={locale} path="/me/" title="/me" printable noindex={!site.features.me}>
  <Banner slot="banner" height="clamp(420px, 52vh, 520px)" locale={locale}>
    <BackgroundCanvas slot="background" />
    <MeHero locale={locale} />
  </Banner>

  <div class="flex flex-col gap-4">
    <AtAGlance locale={locale} />
    <WhatIBring locale={locale} />
    <ExperienceTimeline locale={locale} entries={experience} />

    {experiments.length > 0 && (
      <Card as="section" class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between">
          <SectionHeading text={t(locale, 'me.experiments')} />
          {isEnabled('experiments') && (
            <a href={localizePath('/experiments/', locale, LOCALES)} class="text-sm text-primary underline decoration-dashed underline-offset-4 print:hidden">{t(locale, 'home.allExperiments')}</a>
          )}
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {experiments.map((experiment) => <ExperimentTile experiment={experiment} locale={locale} />)}
        </div>
      </Card>
    )}

    {hasNotes && notes.length > 0 && (
      <Card as="section" class="flex flex-col gap-2 !p-7 md:!px-9">
        <div class="flex items-baseline justify-between">
          <SectionHeading text={t(locale, 'me.notes.title')} />
          <a href={localizePath('/notes/', locale, LOCALES)} class="text-sm text-primary underline decoration-dashed underline-offset-4 print:hidden">{t(locale, 'home.allNotes')}</a>
        </div>
        <p class="text-sm text-muted">{t(locale, 'me.notes.subtitle')}</p>
        <div>{notes.map((note) => <NoteIndexRow note={note} locale={locale} />)}</div>
      </Card>
    )}

    <CertificatesByYear locale={locale} credentials={credentials} />
  </div>

  <MeSidebar slot="aside" locale={locale} />
</BaseLayout>
