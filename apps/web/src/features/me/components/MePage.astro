---
/** The full `/me` recruiter page for one locale: hero, at-a-glance, recent experiments, what I bring, experience,
 * latest notes, recent education (or certificates by year while the education page is off), and a sidebar. Print-friendly. */
import { getCollection } from 'astro:content';
import { localizePath } from '@elvinlab/core';
import plexSansLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import {
  CertificatesByYear,
  EducationRecent,
  loadEducationPages,
  recentEducationRows,
} from '@/features/credentials/index.ts';
import AtAGlance from '@/features/me/components/AtAGlance.astro';
import ExperienceTimeline from '@/features/me/components/ExperienceTimeline.astro';
import MeHero from '@/features/me/components/MeHero.astro';
import MeSidebar from '@/features/me/components/MeSidebar.astro';
import QuickFacts from '@/features/me/components/QuickFacts.astro';
import WhatIBring from '@/features/me/components/WhatIBring.astro';
import { hasPublishedNotes, NoteIndexRow, sortNotes } from '@/features/notes/index.ts';
import { ExperimentRow, experimentsSettings, loadExperiments } from '@/features/portfolio/index.ts';
import { isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { pickLocale } from '@/shared/lib/localized.ts';
import { DEFAULT_OG_IMAGE, profileCardPath } from '@/shared/seo/og.ts';
import { pageSeo } from '@/shared/seo/page-seo.ts';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
// The notes index exists only at `/notes/` (one index, no `/en/notes/`), so its link is not localized.

const experience = (await getCollection('experience')).map((entry) => entry.data);
// The compact education block replaces the long certificates list while the education page exists.
const educationRows = isEnabled('education')
  ? recentEducationRows((await loadEducationPages()).pages, site.education.meRows)
  : [];
const credentials = isEnabled('credentials') && !isEnabled('education') ? (await getCollection('credentials')).map((c) => c.data) : [];
const experiments = isEnabled('experiments') ? (await loadExperiments()).slice(0, experimentsSettings.meRows) : [];
const noteEntries = isEnabled('blog') ? await getCollection('notes') : [];
const allNotes = sortNotes(noteEntries.map((n) => ({ slug: n.id, data: n.data })));
const bySlug = new Map(allNotes.map((note) => [note.slug, note]));
// Curated by capability with a one-line framing; empty falls back to the latest notes.
const curated = (site.me.curatedNotes ?? []).flatMap(({ slug, framing }) => {
  const note = bySlug.get(slug);
  return note ? [{ note, framing }] : [];
});
const notes = curated.length > 0 ? curated.map((entry) => entry.note) : allNotes.slice(0, 3);
const hasNotes = hasPublishedNotes(allNotes);
const seo = pageSeo('me', locale);
// The pitch is the more specific snippet, but only while it fits a search result (160 characters).
const pitch = site.me.pitch?.[locale];
const meDescription = pitch && pitch.length <= 160 ? pitch : seo.description;
---

<BaseLayout
  locale={locale}
  path="/me/"
  title={seo.title}
  pageType="ProfilePage"
  description={meDescription}
  ogImage={site.features.me ? profileCardPath(locale) : DEFAULT_OG_IMAGE}
  ogImageAlt={`${site.identity.name} · ${site.identity.role[locale]}`}
  printable
  noindex={!site.features.me}
>
  {/*
    The /me H1 and hero text are in IBM Plex Sans (46 KB Latin) with `font-display: swap` and no
    other preload, so on a slow run the whole hero reflows when Plex swaps in: the headline and
    pitch re-wrap and the CTA row re-wraps, shifting the content below (CI measured CLS 0.31 once,
    gate 0.1, issue #124). Preloading Plex here makes the swap land before the first paint, so the
    hero never renders in the fallback. The pixel font keeps its own preload (BaseLayout, H1 pages).
  */}
  <link slot="head" rel="preload" as="font" type="font/woff2" href={plexSansLatin} crossorigin />
  <Banner slot="banner" height="clamp(420px, 52vh, 520px)">
    <BackgroundCanvas slot="background" />
    <MeHero locale={locale} />
  </Banner>

  <div class="flex flex-col gap-10">
    <QuickFacts locale={locale} idPrefix="qf-main" class="lg:hidden" />
    <AtAGlance locale={locale} />

    {experiments.length > 0 && (
      <section id="experiments" class="flex scroll-mt-24 flex-col gap-3 border-t border-dashed border-divider pt-10">
        <SectionHeading text={t(locale, 'me.experiments')} />
        <ol class="divide-y divide-dashed divide-divider">
          {experiments.map((experiment, i) => <li><ExperimentRow experiment={experiment} locale={locale} index={i + 1} /></li>)}
        </ol>
        <div class="mt-2 flex flex-col gap-3 border-t border-dashed border-divider pt-4 sm:flex-row sm:items-center sm:justify-between print:hidden">
          <p class="max-w-[48ch] text-sm text-text-secondary text-pretty">{t(locale, 'me.experiments.more.text')}</p>
          <a href={localizePath('/experiments/', locale, LOCALES)} class="flex h-12 shrink-0 items-center justify-center gap-2 rounded-control bg-chip px-5 font-medium transition-colors duration-150 hover:bg-card-hover active:scale-96">
            {t(locale, 'me.experiments.more.cta')}<SocialIcon name="arrow-right" />
          </a>
        </div>
      </section>
    )}

    <WhatIBring locale={locale} />
    <ExperienceTimeline locale={locale} entries={experience} />

    {hasNotes && notes.length > 0 && (
      <section class="flex flex-col gap-3 border-t border-dashed border-divider pt-10">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <SectionHeading text={t(locale, 'me.notes.title')} />
          <a href="/notes/" class="relative text-sm text-primary underline decoration-dashed underline-offset-4 after:absolute after:-inset-x-2 after:-inset-y-3 print:hidden">{t(locale, 'home.allNotes')}</a>
        </div>
        <p class="text-sm text-muted">{t(locale, 'me.notes.subtitle')}</p>
        {curated.length > 0 ? (
          <div class="flex flex-col">
            {curated.map(({ note, framing }) => (
              <a href={localizePath(`/notes/${note.slug}/`, note.data.lang, LOCALES)} class="group flex flex-col gap-1 border-t border-dashed border-divider py-3">
                <span class="flex flex-wrap items-center gap-x-2">
                  <span class="font-medium transition-colors duration-150 group-hover:text-primary">{note.data.title}</span>
                  {note.data.lang !== locale && (
                    <span class="rounded-pill bg-chip px-2 py-0.5 font-mono text-meta text-primary">{t(locale, 'me.notes.articleInSpanish')}</span>
                  )}
                </span>
                <span class="text-sm text-text-secondary">{pickLocale(framing, locale, LOCALES.defaultLocale)}</span>
              </a>
            ))}
          </div>
        ) : (
          <div>{notes.map((note) => <NoteIndexRow note={note} locale={locale} />)}</div>
        )}
      </section>
    )}

    {isEnabled('education')
      ? <EducationRecent locale={locale} rows={educationRows} />
      : <CertificatesByYear locale={locale} credentials={credentials} />}
  </div>

  <MeSidebar slot="aside" locale={locale} />
</BaseLayout>
