---
/** The subscribe card of the notes index: plain markup and one script, no island. Renders nothing
 * unless the blog and `features.subscribe` are on and a Turnstile site key exists. Turnstile is
 * requested on the first focus inside the form, never on page load, to keep the LCP of `/notes/`. */
import { localizePath } from '@elvinlab/core';

import { isSubscribeFormShown } from '@/features/subscribe/availability.ts';
import { SUBSCRIBE_POLICY } from '@/features/subscribe/config.ts';
import { integrations, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const siteKey = integrations.turnstileSiteKey;
const shown = isSubscribeFormShown(site.features, siteKey);
const privacyHref = `${localizePath('/privacy/', locale, LOCALES)}#subscribe`;
---

{shown && (
  <section
    id="subscribe"
    data-subscribe
    data-locale={locale}
    data-site-key={siteKey}
    data-action={SUBSCRIBE_POLICY.turnstileAction}
    data-sending={t(locale, 'subscribe.sending')}
    data-verifying={t(locale, 'subscribe.verifying')}
    data-success={t(locale, 'subscribe.success')}
    data-error={t(locale, 'subscribe.error')}
    class="flex scroll-mt-24 flex-col gap-2 rounded-card bg-card p-5"
  >
    <h2 class="font-display text-base font-bold">{t(locale, 'subscribe.title')}</h2>
    <p class="text-sm text-text-secondary">{t(locale, 'subscribe.body')}</p>
    <form class="flex flex-col gap-3" novalidate>
      <div>
        <label for="subscribe-email" class="mb-1 block text-sm font-medium text-text">{t(locale, 'subscribe.email')}</label>
        <input
          id="subscribe-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          maxlength={SUBSCRIBE_POLICY.emailMaxLength}
          class="h-11 w-full rounded-control border border-divider bg-bg px-3 text-text"
        />
      </div>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <div data-widget class="w-full empty:hidden"></div>
      <button type="submit" class="h-11 w-full rounded-control bg-button font-medium text-white hover:bg-button/90 disabled:cursor-not-allowed disabled:opacity-50">
        {t(locale, 'subscribe.submit')}
      </button>
    </form>
    <p role="status" aria-live="polite" class="text-sm text-text-secondary empty:hidden" data-status></p>
    <noscript><p class="text-sm text-text-secondary">{t(locale, 'subscribe.noscript')}</p></noscript>
    <a href={privacyHref} class="inline-flex h-11 items-center text-sm text-primary underline decoration-dashed underline-offset-4">{t(locale, 'subscribe.privacy')}</a>
  </section>
)}

<script>
  import { callSubscribeAction } from '@/features/subscribe/client/action-client.ts';
  import {
    createTurnstileLoader,
    type TurnstileApi,
  } from '@/features/subscribe/client/turnstile.ts';

  const root = document.querySelector<HTMLElement>('[data-subscribe]');
  const form = root?.querySelector('form');
  const email = form?.querySelector<HTMLInputElement>('input[name=email]');
  const honeypot = form?.querySelector<HTMLInputElement>('input[name=website]');
  const box = form?.querySelector<HTMLElement>('[data-widget]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
  const status = root?.querySelector<HTMLElement>('[data-status]');

  if (root && form && email && honeypot && box && submit && status) {
    const text = root.dataset;
    const load = createTurnstileLoader({
      inject: (src, onLoad, onError) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = onLoad;
        script.onerror = () => onError(new Error('turnstile script failed'));
        document.head.append(script);
      },
      getApi: () => (window as Window & { turnstile?: TurnstileApi }).turnstile,
    });
    let startedAt: number | null = null;
    let token = '';
    let api: TurnstileApi | undefined;
    let widgetId: string | undefined;
    let rendering = false;
    let pending = false;
    let sending = false;

    const say = (message: string) => {
      status.textContent = message;
    };

    const send = async () => {
      sending = true;
      submit.disabled = true;
      say(text['sending'] ?? '');
      const outcome = await callSubscribeAction('request', {
        email: email.value,
        locale: text['locale'],
        website: honeypot.value,
        startedAt: startedAt ?? Date.now(),
        token,
      });
      // A Turnstile token is single use: whatever happened, the next try needs a new one.
      token = '';
      if (api && widgetId !== undefined) api.reset(widgetId);
      sending = false;
      submit.disabled = false;
      if (outcome.ok) {
        form.hidden = true;
        say(text['success'] ?? '');
      } else {
        say(text['error'] ?? '');
      }
    };

    const startWidget = () => {
      if (rendering) return;
      rendering = true;
      load()
        .then((loaded) => {
          api = loaded;
          widgetId = loaded.render(box, {
            sitekey: text['siteKey'] ?? '',
            action: text['action'] ?? '',
            theme: 'auto',
            size: 'flexible',
            callback: (value) => {
              token = value;
              if (pending) {
                pending = false;
                form.requestSubmit();
              }
            },
            'expired-callback': () => {
              token = '';
            },
            'error-callback': () => {
              token = '';
              pending = false;
              say(text['error'] ?? '');
            },
          });
        })
        .catch(() => {
          rendering = false;
          pending = false;
          say(text['error'] ?? '');
        });
    };

    // The first interaction starts both the "time to fill" clock and the lazy Turnstile load.
    form.addEventListener('focusin', () => {
      startedAt ??= Date.now();
      startWidget();
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (sending) return;
      if (!form.reportValidity()) return;
      startedAt ??= Date.now();
      startWidget();
      if (!token) {
        pending = true;
        say(text['verifying'] ?? '');
        return;
      }
      void send();
    });
  }
</script>
