---
/**
 * Compact "recent education" block of `/me`: the newest credentials, one row each (title, issuer,
 * type and date), every row linking to its anchor on the page of `/education/` that holds it, and a
 * closing link to the whole timeline. It replaces the long certificates list while
 * `features.education` is on. Rows are plain markup: no JavaScript, no stylesheet of its own.
 */
import { localizePath } from '@elvinlab/core';

import { educationDateLabel, educationPath } from '@/features/credentials/lib/education.ts';
import type { Credential } from '@/features/credentials/schema.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import SectionHeading from '@/shared/ui/SectionHeading.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = { locale: Locale; rows: { id: string; data: Credential; page: number }[] };

const { locale, rows } = Astro.props;
const hrefFor = (row: { id: string; page: number }) =>
  `${localizePath(educationPath(row.page), locale, LOCALES)}#${row.id}`;
---

{rows.length > 0 && (
  <section id="education" data-me-education class="flex scroll-mt-24 flex-col gap-3 border-t border-dashed border-divider pt-10">
    <SectionHeading text={t(locale, 'me.education')} />
    <ul class="divide-y divide-dashed divide-divider">
      {rows.map((row) => (
        <li>
          <a href={hrefFor(row)} data-me-education-row class="flex min-h-11 items-center justify-between gap-3 px-2 py-3 transition-colors duration-150 hover:bg-card-hover md:rounded-inner">
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="font-bold">{row.data.title}</span>
              <span class="text-sm text-muted">{[row.data.issuer, educationDateLabel(row.data.year, row.data.month, locale), row.data.inProgress ? t(locale, 'me.inProgress') : null].filter(Boolean).join(', ')}</span>
            </span>
            <span class:list={['shrink-0 rounded-inner px-2 py-1 font-mono text-meta font-bold', row.data.kind === 'degree' ? 'bg-button text-white' : 'bg-card text-primary']}>{t(locale, `me.kind.${row.data.kind}`)}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-2 border-t border-dashed border-divider pt-4 print:hidden">
      <a href={localizePath('/education/', locale, LOCALES)} class="flex h-12 w-fit items-center justify-center gap-2 rounded-control bg-chip px-5 font-medium transition-colors duration-150 hover:bg-card-hover active:scale-96">
        {t(locale, 'me.education.more')}<SocialIcon name="arrow-right" />
      </a>
    </div>
  </section>
)}
