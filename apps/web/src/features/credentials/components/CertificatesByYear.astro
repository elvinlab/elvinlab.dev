---
/** Certificates and degrees grouped by year (newest first). Each item links to its verification. */

import { groupCredentialsByYear } from '@/features/credentials/lib/credentials.ts';
import type { Credential } from '@/features/credentials/schema.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Card from '@/shared/ui/Card.astro';
import SectionHeading from '@/shared/ui/SectionHeading.astro';

type Props = { locale: Locale; credentials: Credential[] };

const { locale, credentials } = Astro.props;
const groups = groupCredentialsByYear(credentials.map((data) => ({ data })));
const monthName = (year: number, month?: number) =>
  month ? new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month - 1, 1))) : '';
---

{groups.length > 0 && (
  <Card as="section" class="flex flex-col gap-4 !p-7 md:!px-9">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <SectionHeading text={t(locale, 'me.certificates')} />
      <span class="text-sm text-muted">{t(locale, 'me.certificates.newest')}</span>
    </div>
    {groups.map((group) => (
      <div class="grid grid-cols-1 gap-3 border-t border-dashed border-divider pt-4 md:grid-cols-[140px_1fr]">
        <p class="font-display text-3xl font-bold text-primary">{group.year}</p>
        <ul class="flex flex-col gap-2">
          {group.items.map(({ data }) => {
            const Tag = data.url ? 'a' : 'div';
            const label = t(locale, `me.kind.${data.kind}`);
            return (
              <li>
                <Tag
                  {...data.url ? { href: data.url, rel: 'noopener' } : {}}
                  class:list={['flex items-center justify-between gap-3 rounded-inner bg-chip p-3 transition-colors duration-150', data.url && 'hover:bg-card-hover']}
                >
                  <span class="flex flex-col gap-0.5">
                    <span class="font-bold">{data.title}</span>
                    <span class="text-sm text-muted">{[data.issuer, monthName(data.year, data.month)].filter(Boolean).join(', ')}</span>
                  </span>
                  <span class:list={['rounded-inner px-2 py-1 font-mono text-meta font-bold', data.kind === 'degree' ? 'bg-button text-white' : 'bg-card text-primary']}>{label}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </Card>
)}
