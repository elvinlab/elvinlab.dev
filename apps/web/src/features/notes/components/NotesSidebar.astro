---
/** Notes index sidebar: author card, category and tag lists, RSS callout. */
import { localizePath } from '@elvinlab/core';

import { tagHref } from '@/features/notes/lib/note-tags.ts';
import type { NoteLike } from '@/features/notes/lib/notes.ts';
import type { PulseEntry } from '@/features/notes/lib/pulse.ts';
import { isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Chip from '@/shared/ui/Chip.astro';

import NotesPulse from './NotesPulse.astro';

type Props = {
  locale: Locale;
  categories: { name: string; count: number }[];
  /** The most used tags, always visible. */
  tags: string[];
  /** The remaining tags, inside the native disclosure (none: no disclosure). */
  moreTags?: string[];
  topics: ReadonlyMap<string, string>;
  /** The most active notes, already ranked; empty hides the block. */
  pulse?: PulseEntry<NoteLike>[];
};

const { locale, categories, tags, moreTags = [], topics, pulse = [] } = Astro.props;
// With the "most active" block the column is about 1250 px tall against 700 to 980 px of room on most
// screens, and a taller sticky column cuts off its tags and RSS until the list ends: it flows instead.
const aboutHref = localizePath('/me/', locale, LOCALES);
---

<div class:list={['ni-page flex flex-col gap-6', pulse.length === 0 && 'lg:sticky lg:top-24']}>
  <section class="flex flex-col gap-3">
    <p class="font-display text-lg font-bold">{site.identity.name}</p>
    <p class="text-sm text-text-secondary">{site.identity.role[locale]}</p>
    {isEnabled('me') && (
      <a href={aboutHref} class="flex min-h-11 items-center text-sm text-primary underline decoration-dashed underline-offset-4">
        {t(locale, 'notes.sidebar.about')}
      </a>
    )}
  </section>

  <NotesPulse locale={locale} entries={pulse} />

  {categories.length > 0 && (
    <section class="flex flex-col gap-3 border-t border-dashed border-divider pt-5">
      <h2 class="font-display text-base font-bold">{t(locale, 'notes.sidebar.categories')}</h2>
      <ul class="flex flex-col text-sm">
        {categories.map((category) => (
          <li>
            <a href={tagHref(category.name, topics)} class="flex min-h-11 items-center justify-between text-text-secondary transition-colors duration-150 hover:text-primary">
              <span>{category.name}</span>
              <span class="font-mono text-muted">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {tags.length > 0 && (
    <section class="flex flex-col gap-3 border-t border-dashed border-divider pt-5">
      <h2 class="font-display text-base font-bold">{t(locale, 'notes.sidebar.tags')}</h2>
      <div class="flex flex-wrap gap-1.5">{tags.map((tag) => <Chip href={tagHref(tag, topics)} class="ni-chip">#{tag}</Chip>)}</div>
      {moreTags.length > 0 && (
        <details class="ni-more" data-notes-more>
          <summary>{t(locale, 'notes.sidebar.tags.more', { count: moreTags.length })}</summary>
          <div class="flex flex-wrap gap-1.5">{moreTags.map((tag) => <Chip href={tagHref(tag, topics)} class="ni-chip">#{tag}</Chip>)}</div>
        </details>
      )}
    </section>
  )}

  <section class="flex flex-col gap-2 border-t border-dashed border-divider pt-5">
    <h2 class="font-display text-base font-bold">{t(locale, 'notes.sidebar.rss.title')}</h2>
    <p class="text-sm text-text-secondary">{t(locale, 'notes.sidebar.rss.body')}</p>
    <a href="/rss.xml" class="flex min-h-11 items-center text-sm text-primary underline decoration-dashed underline-offset-4">RSS</a>
  </section>
</div>
