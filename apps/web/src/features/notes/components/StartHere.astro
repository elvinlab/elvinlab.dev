---
/** "Start here" strip above the notes search: one heading and up to three title-only links with their
 * numbers (no excerpt, no chips, no reason), so the list of notes starts right below it. From md up the
 * heading sits beside the links (tight lines for a mouse); on phones each link takes a 44 px line.
 * Layout lives in `notes-index.css`, inlined only on /notes/. */
import { localizePath } from '@elvinlab/core';

import { noteNumber } from '@/features/notes/lib/notes.ts';
import type { StartHereNote } from '@/features/notes/lib/start-here.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; notes: (StartHereNote & { readingMinutes: number })[] };

const { locale, notes } = Astro.props;
---

{notes.length > 0 && (
  <section class="ni-start">
    <h2 class="font-display text-xl font-bold text-primary">{t(locale, 'notes.startHere')}</h2>
    <ul>
      {notes.map((note) => (
        <li>
          <a
            href={localizePath(`/notes/${note.slug}/`, note.data.lang, LOCALES)}
            class="font-medium transition-colors duration-150 hover:text-primary"
          >
            <span class="font-mono text-sm text-muted">{noteNumber(note.data.number)}</span>
            <span>{note.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
