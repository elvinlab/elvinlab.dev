---
/** Copy-link, X, WhatsApp and LinkedIn share buttons for a note: plain links, no third-party script. */
import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = { locale: Locale; url: string; title: string };

const { locale, url, title } = Astro.props;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
// X pre-fills the post with the note title; the link card comes from the page's Open Graph tags.
const x = `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
// WhatsApp takes one message: the title and the link; the preview card comes from the page's Open Graph tags.
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
---

<section class="flex flex-col gap-3 rounded-card bg-card p-5">
  <h2 class="font-display text-base font-bold">{t(locale, 'note.share')}</h2>
  <div class="flex flex-wrap gap-2">
    <button
      type="button"
      data-copy-link
      data-url={url}
      data-label-copy={t(locale, 'note.share.copy')}
      data-label-copied={t(locale, 'note.share.copied')}
      class="flex h-11 basis-full items-center justify-center gap-2 whitespace-nowrap rounded-control bg-chip px-2 text-sm transition-colors duration-150 hover:bg-card-hover"
    >
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
      <span data-copy-label>{t(locale, 'note.share.copy')}</span>
    </button>
    <a href={x} {...externalLinkAttrs(x, site.url)} class="grid h-11 min-w-11 grow place-items-center rounded-control bg-chip transition-colors duration-150 hover:bg-card-hover"><span class="sr-only">X</span><ExternalHint href={x} locale={locale} />
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
    </a>
    <a href={whatsapp} {...externalLinkAttrs(whatsapp, site.url)} class="grid h-11 min-w-11 grow place-items-center rounded-control bg-chip transition-colors duration-150 hover:bg-card-hover"><span class="sr-only">WhatsApp</span><ExternalHint href={whatsapp} locale={locale} />
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path></svg>
    </a>
    <a href={linkedin} {...externalLinkAttrs(linkedin, site.url)} class="grid h-11 min-w-11 grow place-items-center rounded-control bg-chip transition-colors duration-150 hover:bg-card-hover"><span class="sr-only">LinkedIn</span><ExternalHint href={linkedin} locale={locale} />
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0ZM.5 8h4V24h-4V8Zm7.5 0h3.8v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.78 2.65 4.78 6.1V24h-4v-7.1c0-1.7-.03-3.9-2.37-3.9-2.38 0-2.74 1.85-2.74 3.77V24H8V8Z"></path></svg>
    </a>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset['url'] ?? location.href);
        if (label) {
          label.textContent = button.dataset['labelCopied'] ?? 'Copied';
          setTimeout(() => (label.textContent = button.dataset['labelCopy'] ?? 'Copy link'), 1500);
        }
      } catch {
        // Clipboard can be blocked; nothing else to do.
      }
    });
  }
</script>
