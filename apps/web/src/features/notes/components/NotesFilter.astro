---
/** Search box for the notes index. Filters rows client-side (no reload). */
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<div class="flex flex-col gap-3 rounded-card bg-card p-4 sm:flex-row sm:items-center" data-notes-filter>
  <label class="relative grow">
    <span class="sr-only">{t(locale, 'notes.search')}</span>
    <svg class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <input
      type="search"
      placeholder={t(locale, 'notes.search')}
      class="h-11 w-full rounded-control bg-chip pr-3 pl-10 text-text placeholder:text-muted"
      data-notes-search
    />
  </label>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-notes-filter]');
  const search = root?.querySelector<HTMLInputElement>('[data-notes-search]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-note-row]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];
  const empty = document.querySelector<HTMLElement>('[data-notes-empty]');

  const apply = (): void => {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const matchesQuery = !query || (row.dataset['search'] ?? '').includes(query);
      row.hidden = !matchesQuery;
      if (matchesQuery) visible += 1;
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-note-row]:not([hidden])');
    }
    if (empty) empty.hidden = visible > 0;
  };

  search?.addEventListener('input', apply);
</script>
