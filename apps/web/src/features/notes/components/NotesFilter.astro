---
/** Search box, live result count and active tag notice for the notes index. Filters rows client-side (no reload).
 * The count is a polite live region fed by the same filter pass; the empty state (in `NotesIndex`) has a button that clears the search and the tag. */
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; /** How many notes the index holds: the count before the script filters anything. */ total: number };

const { locale, total } = Astro.props;
const one = t(locale, 'notes.results.one', { count: '{count}' });
const other = t(locale, 'notes.results.other', { count: '{count}' });
const initial = total === 1 ? one : other;
---

<div class="flex flex-wrap items-center gap-3" data-notes-filter>
  <label class="ni-search relative grow">
    <span class="sr-only">{t(locale, 'notes.search')}</span>
    <svg class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-muted" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
    <input
      type="search"
      placeholder={t(locale, 'notes.search')}
      class="ni-input h-11 w-full rounded-control bg-chip pr-3 pl-10 text-text placeholder:text-muted"
      data-notes-search
    />
  </label>
  <p class="font-mono text-sm text-text-secondary" aria-live="polite" aria-atomic="true" data-notes-count data-one={one} data-other={other}>{initial.replace('{count}', String(total))}</p>
  <p class="flex flex-wrap items-center gap-x-2 font-mono text-sm text-text-secondary" role="status" data-notes-tag-notice hidden>
    <span>{t(locale, 'notes.filter.tag')}</span>
    <strong class="text-text" data-notes-tag-value></strong>
    <a href="/notes/" class="ni-link inline-flex min-h-6 items-center text-primary underline decoration-dashed underline-offset-4">{t(locale, 'notes.filter.clear')}</a>
  </p>
</div>

<script>
  import { activeTag, rowHasTag } from '@/features/notes/lib/note-tags.ts';
  import { resultsLabel } from '@/features/notes/lib/results-count.ts';

  const root = document.querySelector<HTMLElement>('[data-notes-filter]');
  const search = root?.querySelector<HTMLInputElement>('[data-notes-search]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-note-row]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];
  const empty = document.querySelector<HTMLElement>('[data-notes-empty]');
  const notice = root?.querySelector<HTMLElement>('[data-notes-tag-notice]');
  const noticeValue = root?.querySelector<HTMLElement>('[data-notes-tag-value]');
  const counter = root?.querySelector<HTMLElement>('[data-notes-count]');
  const emptyQuery = document.querySelector<HTMLElement>('[data-notes-empty-query]');
  const emptyQueryLine = document.querySelector<HTMLElement>('[data-notes-empty-query-line]');
  const clear = document.querySelector<HTMLButtonElement>('[data-notes-clear]');
  let tag = activeTag(location.search);

  if (notice && noticeValue && tag) {
    noticeValue.textContent = `#${tag}`;
    notice.hidden = false;
  }

  const apply = (): void => {
    const query = (search?.value ?? '').trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const matches =
        rowHasTag(row.dataset['tags'] ?? '', tag) && (!query || (row.dataset['search'] ?? '').includes(query));
      row.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const group of groups) {
      const shown = group.querySelectorAll('[data-note-row]:not([hidden])').length;
      group.hidden = shown === 0;
      const count = group.querySelector('[data-year-count]');
      if (count) count.textContent = (count.textContent ?? '').replace(/\d+/, String(shown));
    }
    if (empty) empty.hidden = visible > 0;
    if (counter) {
      counter.textContent = resultsLabel(visible, {
        one: counter.dataset['one'] ?? '{count}',
        other: counter.dataset['other'] ?? '{count}',
      });
    }
    if (emptyQuery && emptyQueryLine) {
      emptyQuery.textContent = query === '' ? '' : (search?.value ?? '').trim();
      emptyQueryLine.hidden = query === '';
    }
  };

  clear?.addEventListener('click', () => {
    if (search) search.value = '';
    if (tag) {
      tag = '';
      history.replaceState(history.state, '', location.pathname);
      if (notice) notice.hidden = true;
    }
    apply();
    search?.focus();
  });

  search?.addEventListener('input', apply);
  apply();
</script>
