---
/** A single Lab Note: reading progress, banner title block, decision record, body, prev/next,
 * discussion, and a sidebar with TOC, share and related notes. */
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { localizePath } from '@elvinlab/core';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import DecisionRecord from '@/features/notes/components/DecisionRecord.astro';
import LangBadge from '@/features/notes/components/LangBadge.astro';
import PrevNext from '@/features/notes/components/PrevNext.astro';
import ReadingProgress from '@/features/notes/components/ReadingProgress.astro';
import RelatedNotes from '@/features/notes/components/RelatedNotes.astro';
import ShareCard from '@/features/notes/components/ShareCard.astro';
import Toc from '@/features/notes/components/Toc.astro';
import {
  adjacentNotes,
  formatDate,
  noteNumber,
  readingMinutes,
  relatedNotes,
  sortNotes,
} from '@/features/notes/lib/notes.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import Chip from '@/shared/ui/Chip.astro';

type Props = { entry: CollectionEntry<'notes'>; locale: Locale };

const { entry, locale } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));

const all = (await getCollection('notes')).map((item) => ({ slug: item.id, data: item.data }));
const sameLang = sortNotes(all.filter((note) => note.data.lang === data.lang));
const { prev, next } = adjacentNotes(sameLang, entry.id);
const related = relatedNotes(all, { slug: entry.id, data }, 3);

const path = `/notes/${entry.id}/`;
const canonical = new URL(localizePath(path, data.lang, LOCALES), site.url).href;
const readingLabel = t(locale, 'notes.readingTime', { min: readingMinutes(entry.body ?? '') });
---

<BaseLayout locale={locale} path={path} title={data.title} description={data.description} translated={Boolean(data.translationOf)} article={{ pubDate: data.pubDate, updatedDate: data.updatedDate }}>
  <ReadingProgress slot="banner" />
  <Banner slot="banner" height="360px" locale={locale}>
    <BackgroundCanvas slot="background" />
    <p class="font-mono text-sm text-muted">
      <a href={localizePath('/notes/', locale, LOCALES)} class="hover:text-primary">{t(locale, 'note.breadcrumb')}</a>
      <span class="mx-1">/</span>{data.category}
    </p>
    <div class="mt-3 flex items-center gap-2">
      <span class="font-mono text-sm text-pink">{t(locale, 'notes.entry', { number: noteNumber(data.number) })}</span>
      <LangBadge lang={data.lang} />
    </div>
    <h1 class="mt-2 max-w-[22ch] font-display text-4xl font-bold leading-tight md:text-5xl">{data.title}</h1>
    <p class="mt-3 font-mono text-sm text-muted">
      {site.identity.name} · <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time> · {readingLabel}
    </p>
  </Banner>

  <article data-article class="flex flex-col gap-8 rounded-card bg-card p-6 md:p-10">
    <DecisionRecord locale={locale} decision={data.decision} />
    <div class="prose"><Content /></div>

    <div class="flex flex-col gap-3 border-t border-dashed border-divider pt-6">
      <div class="flex flex-wrap gap-1.5">
        {data.tags.map((tag) => <Chip>#{tag}</Chip>)}
      </div>
      <p class="font-mono text-xs text-muted">
        {data.updatedDate && <>{t(locale, 'note.updated', { date: formatDate(data.updatedDate, locale) })} · </>}{t(locale, 'note.license')}
      </p>
    </div>
  </article>

  <PrevNext locale={locale} prev={prev} next={next} />

  <section class="mt-8 flex flex-col gap-4 rounded-card bg-card p-6" aria-label={t(locale, 'note.discussion')}>
    <h2 class="font-display text-xl font-bold">{t(locale, 'note.discussion')}</h2>
    <p class="text-sm text-muted">{/* Giscus is wired in T20. */}0 comments</p>
  </section>

  <Fragment slot="aside">
    <div class="flex flex-col gap-4 lg:sticky lg:top-24">
      <Toc locale={locale} headings={tocHeadings} />
      <ShareCard locale={locale} url={canonical} />
      <RelatedNotes locale={locale} notes={related} />
    </div>
  </Fragment>
</BaseLayout>
