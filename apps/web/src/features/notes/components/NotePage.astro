---
/** A single Lab Note: reading progress, banner title block, decision record, body, prev/next,
 * discussion, and a sidebar with TOC, share and related notes. */
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { localizePath } from '@elvinlab/core';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import { Comments } from '@/features/comments/index.ts';
import { MarkSection } from '@/features/marks/index.ts';
import DecisionRecord from '@/features/notes/components/DecisionRecord.astro';
import LangBadge from '@/features/notes/components/LangBadge.astro';
import PrevNext from '@/features/notes/components/PrevNext.astro';
import ReadingMode from '@/features/notes/components/ReadingMode.astro';
import ReadingProgress from '@/features/notes/components/ReadingProgress.astro';
import RelatedNotes from '@/features/notes/components/RelatedNotes.astro';
import ShareCard from '@/features/notes/components/ShareCard.astro';
import Toc from '@/features/notes/components/Toc.astro';
import { secondaryMetaSlot } from '@/features/notes/lib/note-meta.ts';
import { tagHref } from '@/features/notes/lib/note-tags.ts';
import {
  adjacentNotes,
  formatDate,
  noteNumber,
  readingMinutes,
  relatedNotes,
  sortNotes,
} from '@/features/notes/lib/notes.ts';
import { translationAlternates, translationsOf } from '@/features/notes/lib/translations.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { noteCardPath } from '@/shared/seo/og.ts';
import Chip from '@/shared/ui/Chip.astro';

type Props = { entry: CollectionEntry<'notes'>; locale: Locale };

const { entry, locale } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));

const all = (await getCollection('notes')).map((item) => ({ slug: item.id, data: item.data }));
const sameLang = sortNotes(all.filter((note) => note.data.lang === data.lang));
const { prev, next } = adjacentNotes(sameLang, entry.id);
const related = relatedNotes(all, { slug: entry.id, data }, 3);

// Notes translated into another language: hreflang alternates, and the language switch goes there.
const group = translationsOf(all, entry.id);
const notePath = (lang: string, slug: string): string => localizePath(`/notes/${slug}/`, lang as Locale, LOCALES);
const alternates = translationAlternates(group, LOCALES.defaultLocale, notePath).map((alternate) => ({
  hreflang: alternate.hreflang,
  href: new URL(alternate.path, site.url).href,
}));
const translations = Object.fromEntries(
  Object.entries(group)
    .filter(([lang]) => lang !== data.lang)
    .map(([lang, slug]) => [lang, notePath(lang, slug)]),
);

const path = `/notes/${entry.id}/`;
const canonical = new URL(localizePath(path, data.lang, LOCALES), site.url).href;
const readingLabel = t(locale, 'notes.readingTime', { min: readingMinutes(entry.body ?? '') });
---

<BaseLayout locale={locale} path={path} title={data.title} description={data.description} translated={false} {...(alternates.length > 0 && { alternates })} translations={translations} article={{ pubDate: data.pubDate, updatedDate: data.updatedDate, tags: data.tags }} ogImage={noteCardPath(entry.id)}>
  <ReadingMode slot="head" part="boot" locale={locale} />
  <ReadingProgress slot="banner" />
  <Banner slot="banner" height="360px" locale={locale}>
    <BackgroundCanvas slot="background" />
    <p class="font-mono text-sm text-muted">
      <a href={localizePath('/notes/', 'es', LOCALES)} class="hover:text-primary">{t(locale, 'note.breadcrumb')}</a>
      <span class="mx-1">/</span><a href={tagHref(data.category)} class="hover:text-primary">{data.category}</a>
    </p>
    <div class="mt-3 flex items-center gap-2">
      <span class="font-mono text-sm text-pink">{t(locale, 'notes.entry', { number: noteNumber(data.number) })}</span>
      {secondaryMetaSlot === 'header' && <LangBadge lang={data.lang} />}
    </div>
    <h1 class="mt-2 max-w-[22ch] font-display text-note-title font-bold leading-tight">{data.title}</h1>
    <p class="mt-3 font-mono text-sm text-muted">
      {secondaryMetaSlot === 'header' && <><span class="whitespace-nowrap">{site.identity.name}</span> · </>}<time class="whitespace-nowrap" datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time> · <span class="whitespace-nowrap">{readingLabel}</span>
    </p>
    <MarkSection slug={entry.id} locale={locale} variant="header" />
  </Banner>

  <article data-article class="flex flex-col gap-8 rounded-card bg-card p-6 md:p-10">
    <ReadingMode part="toggle" locale={locale} />
    <DecisionRecord locale={locale} decision={data.decision} />
    <div class="prose"><Content /></div>

    <div class="flex flex-col gap-3 border-t border-dashed border-divider pt-6">
      <div class="flex flex-wrap items-center gap-1.5">
        {secondaryMetaSlot === 'foot' && <LangBadge lang={data.lang} />}
        {data.tags.map((tag) => <Chip href={tagHref(tag)}>#{tag}</Chip>)}
      </div>
      <p class="font-mono text-meta text-muted">
        {secondaryMetaSlot === 'foot' && <><span class="whitespace-nowrap">{site.identity.name}</span> · </>}{data.updatedDate && <><span class="whitespace-nowrap">{t(locale, 'note.updated', { date: formatDate(data.updatedDate, locale) })}</span> · </>}<span class="whitespace-nowrap">{t(locale, 'note.license')}</span>
      </p>
    </div>
    <MarkSection slug={entry.id} locale={locale} variant="end" />
  </article>

  <PrevNext locale={locale} prev={prev} next={next} />

  <Comments locale={locale} />
  <ReadingMode slot="floating" part="exit" locale={locale} />

  <Fragment slot="aside">
    <div class="flex flex-col gap-4 lg:sticky lg:top-24">
      <Toc locale={locale} headings={tocHeadings} />
      <ShareCard locale={locale} url={canonical} title={entry.data.title} />
      <RelatedNotes locale={locale} notes={related} />
    </div>
  </Fragment>
</BaseLayout>
