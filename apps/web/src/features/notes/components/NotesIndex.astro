---
/** The full `/notes` page for one UI locale: hero banner, filter, year groups and sidebar. */
import { getCollection } from 'astro:content';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import { loadTopics } from '@/features/notes/lib/load-topics.ts';
import { groupByYear, readingMinutes } from '@/features/notes/lib/notes.ts';
import { assertStartHere, selectStartHere } from '@/features/notes/lib/start-here.ts';
import { topTags } from '@/features/notes/lib/top-tags.ts';
import { topicHref } from '@/features/notes/lib/topics.ts';
import { isEnabled } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { pageCardPath } from '@/shared/seo/og.ts';
import { pageSeo } from '@/shared/seo/page-seo.ts';
import Chip from '@/shared/ui/Chip.astro';

import NoteRow from './NoteRow.astro';
import NotesFilter from './NotesFilter.astro';
import NotesSidebar from './NotesSidebar.astro';
import notesIndexCss from './notes-index.css?inline';
import notesIndexMarksCss from './notes-index-marks.css?inline';
import StartHere from './StartHere.astro';

type Props = { locale: Locale; noindex?: boolean };

const { locale, noindex = false } = Astro.props;

const entries = await getCollection('notes');
const notes = entries.map((entry) => ({
  slug: entry.id,
  data: entry.data,
  readingMinutes: readingMinutes(entry.body ?? ''),
}));
assertStartHere(notes);
const { active: topics, tagMap: topicTags } = await loadTopics();
const startHere = selectStartHere(notes, locale);
const groups = groupByYear(notes);

const categoryCounts = new Map<string, number>();
for (const note of notes) categoryCounts.set(note.data.category, (categoryCounts.get(note.data.category) ?? 0) + 1);
const categories = [...categoryCounts.entries()]
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count);
const seo = pageSeo('notes', locale);
const { top: tags, rest: moreTags } = topTags(notes.map((note) => note.data.tags));
---

<BaseLayout locale={locale} path="/notes/" title={seo.title} description={seo.description} pageType="Blog" ogImage={pageCardPath('notes', locale)} noindex={noindex} translated={false} pixelTitle>
  <style slot="head" is:inline set:html={isEnabled('readingProgress') ? notesIndexCss + notesIndexMarksCss : notesIndexCss} />
  <Banner slot="banner" height="320px">
    <BackgroundCanvas slot="background" />
    <h1 class="font-pixel text-hero font-semibold leading-[1.1] text-balance">
      {t(locale, 'notes.title')}<span aria-hidden="true" class="ml-1 inline-block h-3 w-2 bg-pink align-baseline md:h-4"></span>
    </h1>
    <p class="mt-3 max-w-[58ch] text-lg leading-relaxed text-text-secondary">{t(locale, 'notes.subtitle')}</p>
  </Banner>

  <div class="ni-page flex flex-col gap-6">
    <StartHere locale={locale} notes={startHere} />
    {topics.length > 0 && (
      <nav aria-label={t(locale, 'notes.topics')} class="flex flex-wrap items-center gap-1.5">
        <span class="font-mono text-sm text-muted">{t(locale, 'notes.topics')}</span>
        {topics.map(({ topic }) => <Chip href={topicHref(topic.slug)} class="ni-chip">{topic.data.title}</Chip>)}
      </nav>
    )}
    <NotesFilter locale={locale} total={notes.length} />

    {groups.length === 0 && <p class="text-text-secondary">{t(locale, 'notes.empty')}</p>}
    <div data-notes-empty hidden class="ni-empty">
      <p class="ni-empty-title">{t(locale, 'notes.empty')}</p>
      <p class="text-text-secondary" data-notes-empty-query-line hidden>{t(locale, 'notes.empty.query')} <strong data-notes-empty-query></strong></p>
      <p class="text-text-secondary">{t(locale, 'notes.empty.hint')}</p>
      <button type="button" class="ni-btn" data-notes-clear>{t(locale, 'notes.filter.clear')}</button>
    </div>

    {groups.map((group) => (
      <section data-year-group class="flex flex-col">
        <h2 class="flex items-baseline gap-3 font-display text-3xl font-bold text-primary">
          {group.year}
          <span class="font-mono text-sm text-muted" data-year-count>{t(locale, 'notes.count', { count: group.notes.length })}</span>
        </h2>
        <div class="mt-2">
          {group.notes.map((note) => <NoteRow note={note} locale={locale} topics={topicTags} />)}
        </div>
      </section>
    ))}
  </div>

  <slot name="end" />

  <NotesSidebar slot="aside" locale={locale} categories={categories} tags={tags} moreTags={moreTags} topics={topicTags} />
</BaseLayout>
