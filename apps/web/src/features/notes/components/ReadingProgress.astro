---
/** Thin top bar that fills as the reader scrolls the article. Hidden under reduced motion. */
---

<div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[3px] bg-transparent motion-reduce:hidden">
  <div data-reading-progress class="h-full w-0 origin-left bg-gradient-to-r from-primary via-cyan to-pink"></div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-article]');

  const update = (): void => {
    if (!bar || !article) return;
    const start = article.offsetTop;
    const scrollable = article.offsetHeight - window.innerHeight;
    const progress = scrollable <= 0 ? 1 : (window.scrollY - start) / scrollable;
    const clamped = Math.min(1, Math.max(0, progress));
    bar.style.width = `${clamped * 100}%`;
    document.dispatchEvent(new CustomEvent('reading-progress', { detail: clamped }));
  };

  document.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>
