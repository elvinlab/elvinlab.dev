---
/**
 * One entry row in the notes index: number, title, excerpt, category and tag chips, meta column.
 * The title is the row's only link; its `::after` stretches over the row so the whole row opens the
 * note (no script). The category and tag chips sit above that layer (`z-10`) as separate links to the
 * filtered index. The ruled line between rows and the wide-screen margin rule are CSS on this element
 * (`notes-index.css`, inlined by `NotesIndex`), so a row adds no markup for them.
 */
import { localizePath } from '@elvinlab/core';

import { secondaryMetaSlot } from '@/features/notes/lib/note-meta.ts';
import { rowTagList, tagHref, visibleTags } from '@/features/notes/lib/note-tags.ts';
import { formatDate, type NoteLike, noteNumber, searchText } from '@/features/notes/lib/notes.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Chip from '@/shared/ui/Chip.astro';

import LangBadge from './LangBadge.astro';

type Props = {
  note: NoteLike & { readingMinutes: number };
  locale: Locale;
  /** Raw tag to topic slug: a mapped tag links to its topic page instead of the filter. */
  topics?: ReadonlyMap<string, string>;
};

const { note, locale, topics } = Astro.props;
const { data } = note;
const href = localizePath(`/notes/${note.slug}/`, data.lang, LOCALES);
---

<article
  data-note-row
  data-card-link
  data-lang={data.lang}
  data-search={searchText(note)}
  data-tags={rowTagList(data.category, data.tags)}
  class="relative grid grid-cols-[64px_1fr] gap-x-4 gap-y-2 py-5 transition-colors duration-150 hover:bg-card-hover active:scale-96 md:grid-cols-[88px_1fr_auto] md:rounded-inner md:px-3"
>
  <span class="pt-1 font-mono text-sm text-muted">{noteNumber(data.number)}</span>

  <div class="flex flex-col gap-2">
    <h3 class="text-lg font-bold leading-snug">
      <a href={href} class="transition-colors duration-150 after:absolute after:inset-0 hover:text-primary">{data.title}</a>
    </h3>
    <p class="text-sm leading-relaxed text-text-secondary">{data.description}</p>
    <div class="flex flex-wrap items-center gap-1.5">
      {secondaryMetaSlot === 'foot' && <LangBadge lang={data.lang} />}
      <Chip href={tagHref(data.category, topics)} class="relative z-10">{data.category}</Chip>
      {visibleTags(data.tags, data.category).map((tag) => <Chip href={tagHref(tag, topics)} class="relative z-10">#{tag}</Chip>)}
    </div>
  </div>

  <div class="col-start-2 flex items-center gap-3 text-sm text-muted md:col-start-3 md:flex-col md:items-end md:gap-1 md:pt-1 md:text-right">
    <span class="flex items-center gap-2">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate, locale)}</time>
      {secondaryMetaSlot === 'header' && <LangBadge lang={data.lang} />}
    </span>
    <span class="whitespace-nowrap">{t(locale, 'notes.readingTime', { min: note.readingMinutes })}</span>
  </div>
</article>
