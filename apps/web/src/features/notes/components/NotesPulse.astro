---
/** "Most active" list of the notes index sidebar: up to five notes ranked by interaction, each with
 * its strongest signal. Renders nothing when the build snapshot holds no interaction, so a fork
 * without analytics or marks gets the sidebar it had. No script: the data is frozen at build time.
 * Layout lives in `notes-pulse.css`, which `NotesIndex` inlines only when there is something to show. */
import { localizePath } from '@elvinlab/core';

import type { NoteLike } from '@/features/notes/lib/notes.ts';
import type { PulseEntry } from '@/features/notes/lib/pulse.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; entries: PulseEntry<NoteLike>[] };

const { locale, entries } = Astro.props;
const label = ({ kind, count }: PulseEntry<NoteLike>['top']) =>
  t(locale, `notes.pulse.${kind}.${count === 1 ? 'one' : 'many'}`, { count });
---

{entries.length > 0 && (
  <section class="ni-pulse flex flex-col gap-3 border-t border-dashed border-divider pt-5">
    <h2 class="font-display text-base font-bold">{t(locale, 'notes.pulse.title')}</h2>
    <ol>
      {entries.map(({ note, top }, index) => (
        <li>
          <a href={localizePath(`/notes/${note.slug}/`, note.data.lang, LOCALES)}>
            <span class="ni-pulse-rank" aria-hidden="true">{index + 1}</span>
            <span class="ni-pulse-title">{note.data.title}</span>
            <span class="ni-pulse-meta">{label(top)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
