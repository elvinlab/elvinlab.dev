---
/** Table of contents built from the note's h2 headings, with live scroll progress. */
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; headings: { slug: string; text: string }[] };

const { locale, headings } = Astro.props;
---

{headings.length > 0 && (
  <nav class="rounded-card bg-card p-5" aria-label={t(locale, 'note.toc')} data-toc>
    <div class="flex items-center justify-between">
      <button
        type="button"
        class="flex w-full items-center justify-between gap-2 font-display text-base font-bold lg:pointer-events-none"
        data-toc-toggle
        aria-expanded="false"
      >
        <span>{t(locale, 'note.toc')}</span>
        <span class="flex items-center gap-2">
          <span data-toc-progress class="font-mono text-xs text-muted">0%</span>
          <svg class="transition-transform duration-150 lg:hidden" data-toc-chevron viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </span>
      </button>
    </div>
    <ol data-toc-list hidden class="mt-3 flex flex-col gap-1 lg:flex lg:!block">
      {headings.map((heading, index) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            class="flex gap-2 rounded-inner py-1.5 text-sm text-text-secondary transition-colors duration-150 hover:text-primary aria-[current=true]:text-primary"
          >
            <span class="font-mono text-xs text-muted">{String(index + 1).padStart(2, '0')}</span>
            <span>{heading.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const toggle = toc.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const list = toc.querySelector<HTMLElement>('[data-toc-list]');
    const chevron = toc.querySelector<SVGElement>('[data-toc-chevron]');
    const progress = toc.querySelector<HTMLElement>('[data-toc-progress]');
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];

    const isDesktop = (): boolean => window.matchMedia('(min-width: 1024px)').matches;
    // Desktop shows the list always; mobile toggles it.
    const sync = (): void => {
      if (list) list.hidden = !isDesktop() && toggle?.getAttribute('aria-expanded') !== 'true';
    };
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      chevron?.style.setProperty('transform', open ? 'none' : 'rotate(180deg)');
      sync();
    });
    window.addEventListener('resize', sync);
    sync();

    document.addEventListener('reading-progress', (event) => {
      const value = (event as CustomEvent<number>).detail;
      if (progress) progress.textContent = `${Math.round(value * 100)}%`;
    });

    // Highlight the heading currently in view.
    const targets = links
      .map((link) => document.getElementById(link.dataset['tocLink'] ?? ''))
      .filter((el): el is HTMLElement => Boolean(el));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            link.setAttribute('aria-current', String(link.dataset['tocLink'] === entry.target.id));
          }
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    for (const target of targets) observer.observe(target);
  }
</script>
