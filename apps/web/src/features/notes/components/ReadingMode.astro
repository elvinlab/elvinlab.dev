---
/** Reading mode for notes, behind `features.readingMode`. One component, three parts: the `boot`
 * script for `<head>`, the `toggle` shown in the note, and the floating `exit` button. */
import readingCss from '@/features/notes/components/reading-mode.css?raw';
import { readingBootScript, readingControlsScript } from '@/features/notes/lib/reading-mode.ts';
import { isEnabled } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { part: 'boot' | 'toggle' | 'exit'; locale: Locale };

const { part, locale } = Astro.props;
const enabled = isEnabled('readingMode');
---

{enabled && part === 'boot' && (
  <>
    <script is:inline set:html={readingBootScript()} />
    {/* Inlined only here: pages and builds without the feature never carry these rules. */}
    <style is:inline set:html={readingCss} />
  </>
)}

{enabled && part === 'toggle' && (
  <div class="-mb-2 flex justify-end print:hidden">
    <button
      type="button"
      data-reading-toggle
      aria-pressed="false"
      class="relative inline-flex h-9 items-center gap-2 rounded-pill bg-chip px-3 font-mono text-meta text-text-secondary transition-colors duration-150 hover:text-text aria-pressed:text-primary before:absolute before:inset-x-0 before:-inset-y-1 before:content-['']"
    >
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"></path><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"></path></svg>
      {t(locale, 'reading.toggle')}
    </button>
  </div>
)}

{enabled && part === 'exit' && (
  <>
    <button type="button" data-reading-exit class="reading-exit print:hidden">
      {t(locale, 'reading.exit')}
    </button>
    {/* Last in the body, so the toggle and this button already exist when it runs. */}
    <script is:inline set:html={readingControlsScript()} />
  </>
)}
