---
/** A static topic page `/notes/tag/<topic>/`: compact paper banner with the title and intro, the
 * topic's notes newest first, and a link back to the index. Static HTML, no script. */
import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import { type ActiveTopic, topicHref } from '@/features/notes/lib/topics.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { topicCardPath } from '@/shared/seo/og.ts';
import Stamp from '@/shared/ui/Stamp.astro';
import stampCss from '@/shared/ui/stamp.css?inline';
import stampCornerCss from '@/shared/ui/stamp-corner.css?inline';

import NoteIndexRow from './NoteIndexRow.astro';

type Props = { active: ActiveTopic; locale: Locale };

const { active, locale } = Astro.props;
const { topic, notes } = active;
const path = topicHref(topic.slug);
---

<BaseLayout locale={locale} path={path} title={topic.data.title} description={topic.data.description} pageType="CollectionPage" ogImage={topicCardPath(topic.slug)} trail={[{ name: t(locale, 'nav.notes'), path: '/notes/' }]} translated={false} pixelTitle>
  <style slot="head" is:inline set:html={stampCss + stampCornerCss} />
  <Banner slot="banner" height="320px" grid>
    <BackgroundCanvas slot="background" />
    <div class="relative">
      <Stamp class="stamp-corner">{t(locale, 'stamp.topic')}</Stamp>
      <p class="font-mono text-sm text-muted">
        <a href="/notes/" class="hover:text-primary">{t(locale, 'note.breadcrumb')}</a>
        <span class="mx-1">/</span>{t(locale, 'notes.topics')}
      </p>
      <h1 class="mt-3 font-pixel text-hero font-semibold leading-[1.1] text-balance">
        {topic.data.title}<span aria-hidden="true" class="ml-1 inline-block h-3 w-2 bg-pink align-baseline md:h-4"></span>
      </h1>
      <p class="mt-3 max-w-[58ch] text-lg leading-relaxed text-text-secondary">{topic.data.intro}</p>
    </div>
  </Banner>

  <section class="flex flex-col">
    <h2 class="flex items-baseline gap-3 font-display text-3xl font-bold text-primary">
      {t(locale, 'nav.notes')}
      <span class="font-mono text-sm text-muted">{t(locale, 'notes.count', { count: notes.length })}</span>
    </h2>
    <div class="mt-2" data-topic-notes={notes.length}>
      {notes.map((note) => <NoteIndexRow note={note} locale={locale} />)}
    </div>
  </section>
</BaseLayout>
