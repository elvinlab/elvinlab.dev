---
/** Home notebook index: heading, an "all notes" link and compact rows for older notes. */
import { localizePath } from '@elvinlab/core';

import { NoteIndexRow, type NoteLike } from '@/features/notes/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; notes: NoteLike[] };

const { locale, notes } = Astro.props;
---

{notes.length > 0 && (
  <section class="flex flex-col gap-3 rounded-card bg-card p-6">
    <div class="flex items-baseline justify-between">
      <h2 class="flex items-center gap-3 font-display text-2xl font-bold">
        <span class="h-5 w-1 rounded-pill bg-primary" aria-hidden="true"></span>{t(locale, 'home.notebook')}
      </h2>
      <a href={localizePath('/notes/', locale, LOCALES)} class="text-sm text-primary underline decoration-dashed underline-offset-4">
        {t(locale, 'home.allNotes')}
      </a>
    </div>
    <div>
      {notes.map((note) => <NoteIndexRow note={note} locale={locale} />)}
    </div>
  </section>
)}
