---
/** Home notebook index: heading, an "all notes" link and compact rows for older notes. */
import { NoteIndexRow, type NoteLike } from '@/features/notes/index.ts';
import { otherNoteLanguages } from '@/features/portfolio/lib/notebook-language.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; notes: NoteLike[] };

const { locale, notes } = Astro.props;
const otherLangs = otherNoteLanguages(locale, notes.map((note) => note.data.lang));
const languageNames = new Intl.DisplayNames([locale], { type: 'language' });
const langNote = otherLangs
  .map((lang) => languageNames.of(lang) ?? lang)
  .join(', ');
// The notes index exists only at `/notes/` (one index, no `/en/notes/`), so the link is not localized.
---

{notes.length > 0 && (
  <section class="flex flex-col gap-3 rounded-card bg-card p-6">
    <div class="flex items-baseline justify-between">
      <h2 class="flex items-center gap-3 font-pixel text-section font-semibold">
        <span class="h-5 w-1 rounded-pill bg-primary" aria-hidden="true"></span>{t(locale, 'home.notebook')}
      </h2>
      <a href="/notes/" class="relative text-sm text-primary underline decoration-dashed underline-offset-4 after:absolute after:-inset-x-2 after:-inset-y-3">
        {t(locale, 'home.allNotes')}
      </a>
    </div>
    {otherLangs.length > 0 && <p data-notebook-lang-note class="text-sm text-text-secondary">{t(locale, 'home.notebook.langNote', { language: langNote })}</p>}
    <div>
      {notes.map((note) => <NoteIndexRow note={note} locale={locale} />)}
    </div>
  </section>
)}
