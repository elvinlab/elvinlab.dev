---
/**
 * Home hero card for the most recent note: meta, title, decision record and a read CTA. The title
 * is the card's only link; its `::after` stretches over the card so the whole card opens the note,
 * and the CTA is a decorative twin of that link (a second link to the same page would be announced twice).
 */
import { localizePath } from '@elvinlab/core';

import {
  DecisionRecord,
  formatDate,
  LangBadge,
  type NoteData,
  noteNumber,
  readingMinutes,
  secondaryMetaSlot,
} from '@/features/notes/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale: Locale; slug: string; data: NoteData; body: string };

const { locale, slug, data, body } = Astro.props;
const href = localizePath(`/notes/${slug}/`, data.lang, LOCALES);
const readingLabel = t(locale, 'notes.readingTime', { min: readingMinutes(body) });
---

<section data-card-link class="relative flex flex-col gap-5 rounded-card bg-card p-6 transition-colors duration-150 hover:bg-card-hover md:p-8">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="flex items-center gap-2 font-mono text-sm">
      <span class="text-pink">{t(locale, 'notes.entry', { number: noteNumber(data.number) })}</span>
      <span class="text-muted">{t(locale, 'home.latest')}</span>
    </span>
    <span class="flex items-center gap-2 font-mono text-sm text-muted">
      <time datetime={data.pubDate.toISOString()} class="hidden sm:inline">{formatDate(data.pubDate, locale)}</time>
      <span class="whitespace-nowrap">{readingLabel}</span>
      {secondaryMetaSlot === 'header' && <LangBadge lang={data.lang} />}
    </span>
  </div>

  <h2 class="font-display text-card-title font-bold leading-tight">
    <a href={href} class="transition-colors duration-150 after:absolute after:inset-0 hover:text-primary">{data.title}</a>
  </h2>

  <DecisionRecord locale={locale} decision={data.decision} />

  <div class="flex items-center gap-3">
    <span aria-hidden="true" class="flex h-11 w-fit items-center rounded-control bg-button px-5 font-medium text-white">
      {t(locale, 'home.readNote')}
    </span>
    {secondaryMetaSlot === 'foot' && <LangBadge lang={data.lang} />}
  </div>
</section>
