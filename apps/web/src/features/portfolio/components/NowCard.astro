---
/** Dated "Now" card: what the owner is focused on, from the `now` block of the site config. Renders
 * nothing without that block, so no empty heading or wrapper is left behind. */
import { localizePath } from '@elvinlab/core';

import { formatNowDate } from '@/features/portfolio/lib/portfolio.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const { now } = site;
// Internal paths follow the visitor's locale; links to other sites open in a new tab.
const isInternal = (href: string) => href.startsWith('/');
---

{now && (
  <section data-now-card class="flex flex-col gap-3 rounded-card bg-card p-5">
    <div class="flex flex-col gap-1">
      <h2 class="font-display text-base font-bold">{t(locale, 'now.title')}</h2>
      <p class="text-meta text-muted">{t(locale, 'now.updated', { date: formatNowDate(now.updatedAt, locale) })}</p>
    </div>
    <ul class="flex flex-col gap-3">
      {now.items.map((item, index) => {
        const text = item.text[locale] ?? item.text[LOCALES.defaultLocale] ?? '';
        return (
          <li class:list={['flex flex-col gap-1', index > 0 && 'border-t border-dashed border-divider pt-3']}>
            <span class="font-mono text-meta text-muted">{t(locale, `now.kind.${item.kind}`)}</span>
            {item.href ? (
              <a
                href={isInternal(item.href) ? localizePath(item.href, locale, LOCALES) : item.href}
                {...externalLinkAttrs(item.href, site.url)}
                class="text-sm text-primary underline decoration-dashed underline-offset-4"
              >{text}<ExternalHint href={item.href} locale={locale} /></a>
            ) : (
              <span class="text-sm text-text-secondary">{text}</span>
            )}
          </li>
        );
      })}
    </ul>
  </section>
)}
