---
/**
 * One project: optional lazy screenshot, title, subtitle, status, the problem and the result (plus
 * the contribution unless `compact`), up to three tags on the full variant, and text links to the
 * live site, the case (a published note) and the code. Only links that exist are shown.
 */
import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import type { Project } from '@/features/portfolio/lib/load-projects.ts';
import { caseLinkLabelKey, projectTagLabel, visibleProjectTags } from '@/features/portfolio/lib/projects.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';
import { resolveProjectImage } from '@/shared/lib/project-image.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = {
  project: Project;
  locale: Locale;
  compact?: boolean;
  /** Heading level of the title: `h3` under a section heading, `h2` right under the page title. */
  headingTag?: 'h2' | 'h3';
};

const { project, locale, compact = false, headingTag: Heading = 'h3' } = Astro.props;
const text = (value: Project['subtitle']) => pickLocale(value, locale, LOCALES.defaultLocale);
const image = project.image ? resolveProjectImage(project.image.file) : undefined;
const subtitle = text(project.subtitle);
type FactKey = 'project.problem' | 'project.contribution' | 'project.result';
const facts = (
  [
    ['project.problem', text(project.problem)],
    ...(compact ? [] : [['project.contribution', text(project.contribution)] as const]),
    ['project.result', text(project.result)],
  ] satisfies (readonly [FactKey, string])[]
).filter(([, value]) => value !== '');
const description = text(project.description);
const caseHref = project.note
  ? localizePath(`/notes/${project.note}/`, project.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : undefined;
const tags = compact ? [] : visibleProjectTags(project.tags);
const LINK = 'inline-flex min-h-11 items-center rounded-control px-3 text-sm text-primary underline decoration-dashed underline-offset-4 transition-colors duration-150 hover:bg-card-hover';
---

<article class="flex flex-col gap-3 rounded-card bg-card p-4">
  {image && project.image && (
    <Image
      src={image}
      alt={pickLocale(project.image.alt, locale, LOCALES.defaultLocale)}
      format="webp"
      quality={80}
      width={800}
      height={500}
      widths={[400, 800]}
      sizes="(min-width: 768px) 400px, 100vw"
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full rounded-inner object-cover object-top outline outline-1 -outline-offset-1 outline-divider"
    />
  )}
  {!image && !compact && (
    <div class="flex aspect-[16/10] w-full flex-col justify-between rounded-inner bg-chip p-4 outline outline-1 -outline-offset-1 outline-divider" aria-hidden="true">
      <span class="font-mono text-meta text-muted">{project.year}</span>
      <span class="font-mono text-lg text-text-secondary text-balance">{project.id}</span>
    </div>
  )}
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <Heading class="font-display text-lg font-bold">{project.title}</Heading>
      {subtitle && <p class="text-sm text-muted">{subtitle}</p>}
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-chip px-2 py-0.5 font-mono text-meta text-text-secondary">
      <span class:list={['size-2 rounded-pill', project.status === 'running' ? 'bg-ok' : 'bg-primary']} aria-hidden="true"></span>
      {t(locale, `exp.status.${project.status}`)}
    </span>
  </div>
  {facts.length > 0 ? (
    <dl class="flex flex-col gap-2 text-sm leading-relaxed">
      {facts.map(([key, value]) => (
        <div>
          <dt class="font-mono text-meta text-muted">{t(locale, key)}</dt>
          <dd class="text-text-secondary">{value}</dd>
        </div>
      ))}
    </dl>
  ) : (
    <p class="text-sm leading-relaxed text-text-secondary">{description}</p>
  )}
  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => <li class="rounded-pill bg-chip px-2.5 py-0.5 font-mono text-meta text-text-secondary">{projectTagLabel(tag)}</li>)}
    </ul>
  )}
  {(project.url || caseHref || project.repo) && (
    <div class="-mx-3 -mb-2 mt-auto flex flex-wrap gap-x-1 print:hidden">
      {project.url && (
        <a href={project.url} {...externalLinkAttrs(project.url, site.url)} class={LINK}>{t(locale, 'project.live')}<ExternalHint href={project.url} locale={locale} /></a>
      )}
      {caseHref && (
        <a href={caseHref} class={LINK}>{t(locale, caseLinkLabelKey(locale, project.noteLang ?? LOCALES.defaultLocale))}</a>
      )}
      {project.repo && (
        <a href={project.repo} {...externalLinkAttrs(project.repo, site.url)} class={LINK}>{t(locale, 'project.code')}<ExternalHint href={project.repo} locale={locale} /></a>
      )}
    </div>
  )}
</article>
