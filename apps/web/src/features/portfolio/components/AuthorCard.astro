---
/** Sidebar author card: profile photo or initials, name, bio and social icon buttons. */

import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import { isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { resolveAvatar } from '@/shared/lib/avatar.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const avatar = resolveAvatar(site.identity.avatar);
const initials = site.identity.name.split(' ').slice(0, 2).map((part) => part[0]).join('');
const links = [
  ...site.socials.map((social) => ({ href: social.url, label: social.label, icon: social.icon, rel: 'me' })),
  ...(isEnabled('contact') ? [{ href: localizePath('/contact/', locale, LOCALES), label: t(locale, 'nav.contact'), icon: 'mail', rel: '' }] : []),
  { href: '/rss.xml', label: 'RSS', icon: 'rss', rel: '' },
];
---

<section class="author-card flex flex-col gap-4 rounded-card bg-card p-5">
  <div class="author-photo size-24 overflow-hidden lg:aspect-square lg:size-auto lg:w-full md:hidden md:animate-fade-in-up md:[body:has([data-banner]:not([data-expanded]))_&]:block rounded-inner bg-gradient-to-br from-primary/25 to-cyan/15">
    {avatar ? (
      // Lazy: on phones the sidebar sits below the content, so the photo is never the LCP element.
      <Image src={avatar} alt={site.identity.name} format="webp" quality={80} class="size-full object-cover" loading="lazy" decoding="async" />
    ) : (
      <div class="grid size-full place-items-center font-display text-5xl font-bold text-primary" aria-hidden="true">
        {initials}
      </div>
    )}
  </div>
  <div class="author-text flex flex-col gap-1">
    <p class="font-display text-lg font-bold">{site.identity.name}</p>
    <p class="text-sm leading-relaxed text-text-secondary">{t(locale, 'author.bio')}</p>
  </div>
  <ul class="author-links flex flex-wrap gap-1.5">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          {...externalLinkAttrs(link.href, site.url, link.rel)}
          class="grid size-11 place-items-center rounded-control bg-chip text-primary transition-colors duration-150 hover:bg-card-hover"
        >
          <span class="sr-only">{link.label}</span><ExternalHint href={link.href} locale={locale} />
          <SocialIcon name={link.icon} />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Phones: the card is a quiet row (small photo beside the name and bio, icons under them) with no
     box, so it does not read as leftovers after the content. From md up it is the boxed card. The
     rule lives here and not in utilities because it ships only on pages that render this card. */
  @media (max-width: 47.99rem) {
    .author-card {
      display: grid;
      grid-template-columns: 4rem 1fr;
      align-items: center;
      gap: 0.5rem 1rem;
      padding: 0;
      background: transparent;
    }
    .author-photo {
      width: 4rem;
      height: 4rem;
    }
    .author-links {
      grid-column: 1 / -1;
    }
  }
</style>
