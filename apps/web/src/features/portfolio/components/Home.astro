---
/** The home page for one UI locale: hero banner, latest note, notebook index, experiments,
 * pillars, the Now card, and a sidebar with the author card, the recruiter card and the footprint card. Each of those
 * sections follows `homeSections` (appearance preset plus `home` overrides) and renders nothing
 * when it is off; the sidebar column only exists while at least one of its cards is on. */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { localizePath } from '@elvinlab/core';
import pixelifySansLatin from '@fontsource-variable/pixelify-sans/files/pixelify-sans-latin-wght-normal.woff2?url';

import { BackgroundCanvas } from '@/features/backgrounds/index.ts';
import { MarkSection } from '@/features/marks/index.ts';
import { hasPublishedNotes, sortNotes } from '@/features/notes/index.ts';
import AuthorCard from '@/features/portfolio/components/AuthorCard.astro';
import ExperimentsGrid from '@/features/portfolio/components/ExperimentsGrid.astro';
import HiringCard from '@/features/portfolio/components/HiringCard.astro';
import LatestNote from '@/features/portfolio/components/LatestNote.astro';
import NotebookIndex from '@/features/portfolio/components/NotebookIndex.astro';
import NowCard from '@/features/portfolio/components/NowCard.astro';
import Pillars from '@/features/portfolio/components/Pillars.astro';
import { sortExperiments } from '@/features/portfolio/lib/portfolio.ts';
import { homeSections, isEnabled, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import Banner from '@/shared/layout/Banner.astro';
import BannerToggle from '@/shared/layout/BannerToggle.astro';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { resolveAvatar } from '@/shared/lib/avatar.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
const pills = [t(locale, 'home.pill.1'), t(locale, 'home.pill.2'), t(locale, 'home.pill.3')];

const noteEntries = isEnabled('blog') ? await getCollection('notes') : [];
const notes = sortNotes(noteEntries.map((entry) => ({ slug: entry.id, data: entry.data, body: entry.body ?? '' })));
const [latest, ...rest] = notes;
const hasNotes = hasPublishedNotes(notes);
// The Now card needs both its switch and a `now` block in the config, so it can never leave an
// empty sidebar column behind.
const showNow = homeSections.now && site.now !== undefined;
const hasSidebar =
  homeSections.authorCard || homeSections.hiringCard || homeSections.marks;

const avatar = resolveAvatar(site.identity.avatar);
const initials = site.identity.name.split(' ').slice(0, 2).map((part) => part[0]).join('');

const experiments = homeSections.experiments
  ? sortExperiments(await getCollection('experiments')).map((entry) => entry.data)
  : [];
---

<BaseLayout locale={locale} path="/" title={site.identity.name}>
  <link slot="head" rel="preload" as="font" type="font/woff2" href={pixelifySansLatin} crossorigin />
  <Banner slot="banner" height="150px" expandedHeight="clamp(440px, 56vh, 520px)" compactExpandedHeight="29rem" expandable>
    <BackgroundCanvas slot="background" />
    <BannerToggle slot="toggle" locale={locale} />
    <div data-hero-content data-home-hero class="flex flex-col md:grid md:grid-cols-[minmax(0,1fr)_auto] lg:grid-cols-[minmax(0,1fr)_280px] md:items-end md:gap-12">
      <div class="flex flex-col">
        <p data-hero-byline class="mb-1flex flex-col gap-0.5 md:hidden">
          <span class="font-display text-lg font-bold">{site.identity.name}</span>
          <span class="text-sm text-text-secondary">{site.identity.role[locale]}</span>
        </p>
        <h1 class="max-w-hero font-pixel text-hero font-semibold leading-[1.1] text-balance">
          {t(locale, 'home.headline')}<span aria-hidden="true" class="ml-1 inline-block h-3 w-2.5 bg-pink align-baseline md:h-4"></span>
        </h1>
        <p class="mt-4 max-w-[52ch] text-intro leading-relaxed text-text-secondary">{t(locale, 'home.intro')}</p>
        {homeSections.heroPills && (
          <ul class="mt-5 hidden flex-wrap gap-2 md:flex">
            {pills.map((pill) => (
              <li class="rounded-pill bg-chip px-3 py-1.5 text-sm text-text-secondary">{pill}</li>
            ))}
          </ul>
        )}
        {isEnabled('me') && (
          <a data-hero-cta href={localizePath('/me/', locale, LOCALES)} class="mt-2.5 inline-flex h-11 items-center justify-center self-start rounded-control bg-button px-4 font-medium text-white active:scale-96 md:hidden">
            {t(locale, 'recruiter.openProfile')}
          </a>
        )}
      </div>
      <figure class="hidden animate-fade-in-up md:block md:w-56 lg:w-auto lg:text-center">
        <div class="size-56 overflow-hidden lg:mx-auto rounded-card bg-gradient-to-br from-primary/25 to-cyan/15">
          {avatar ? (
            // Lazy: hidden below md, and the h1 block is the LCP element above it.
            <Image src={avatar} alt={site.identity.name} format="webp" quality={80} class="size-full object-cover" loading="lazy" decoding="async" />
          ) : (
            <div class="grid size-full place-items-center font-display text-5xl font-bold text-primary" aria-hidden="true">
              {initials}
            </div>
          )}
        </div>
        <figcaption class="mt-3 flex flex-col gap-0.5">
          <span class="font-display text-lg font-bold">{site.identity.name}</span>
          <span class="text-sm text-balance text-text-secondary">{site.identity.role[locale]}</span>
        </figcaption>
      </figure>
    </div>
  </Banner>

  <div class="flex flex-col gap-10">
    {hasNotes && latest && <LatestNote locale={locale} slug={latest.slug} data={latest.data} body={latest.body} />}
    {homeSections.notebookIndex && hasNotes && rest.length > 0 && <NotebookIndex locale={locale} notes={rest.slice(0, 5)} />}
    {homeSections.experiments && <ExperimentsGrid locale={locale} experiments={experiments} />}
    {homeSections.pillars && <Pillars locale={locale} />}
    {showNow && <NowCard locale={locale} />}
  </div>

  {hasSidebar && (
    <Fragment slot="aside">
      <div class="flex flex-col gap-4 md:grid md:grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] lg:flex">
        {homeSections.authorCard && <AuthorCard locale={locale} />}
        {homeSections.hiringCard && <HiringCard locale={locale} />}
        {homeSections.marks && (
          <section data-marks-card class="rounded-card bg-card px-4 py-2">
            <MarkSection slug="home" locale={locale} variant="card" />
          </section>
        )}
      </div>
    </Fragment>
  )}
</BaseLayout>
