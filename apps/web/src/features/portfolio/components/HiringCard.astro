---
/** "Hiring?" recruiter card: availability, relevant experience and links to /me and the CV. */
import { localizePath } from '@elvinlab/core';

import { splitStatus, yearsSince } from '@/features/portfolio/lib/portfolio.ts';
import { isEnabled, resolveCvUrl, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const { recruiter, identity } = site;
const years = yearsSince(identity.startedYear);
const cvUrl = resolveCvUrl(recruiter.cvUrl, locale, LOCALES.defaultLocale);
// "Working at Buo · open to chat": the first part leads, the rest are short tags with a dot. A
// status without extra parts is shown as a single tag, as before.
const { headline, tags } = splitStatus(recruiter.status[locale] ?? '');
const lead = tags.length > 0 ? headline : '';
const chips = (tags.length > 0 ? tags : [headline]).filter((chip) => chip !== '');
---

<section class="flex flex-col gap-4 overflow-hidden rounded-card bg-card p-5">
  <span class="-mx-5 -mt-5 h-[3px] bg-gradient-to-r from-primary via-cyan to-pink"></span>
  <div>
    <h2 class="font-display text-lg font-bold">{t(locale, 'recruiter.title')}</h2>
  </div>
  {recruiter.available && (
    <div data-recruiter-status class="flex flex-col gap-2">
      {lead && <p class="text-sm font-medium">{lead}</p>}
      {chips.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {chips.map((chip) => (
            <li class="flex items-center gap-1.5 rounded-control bg-chip px-2.5 py-1 text-meta text-text-secondary">
              <span class:list={['size-2 shrink-0 rounded-pill', recruiter.openToWork ? 'bg-ok' : 'bg-primary']} aria-hidden="true"></span>{chip}
            </li>
          ))}
        </ul>
      )}
    </div>
  )}
  <p class="text-sm text-text-secondary">{t(locale, 'recruiter.experience')}: {t(locale, 'recruiter.years', { years })}</p>
  <div class="flex flex-col gap-2">
    {isEnabled('me') && (
      <a href={localizePath('/me/', locale, LOCALES)} class="flex h-11 items-center justify-center rounded-control bg-button px-4 font-medium text-white active:scale-96">
        {t(locale, 'recruiter.openProfile')}
      </a>
    )}
    {cvUrl && (
      <a href={cvUrl} {...externalLinkAttrs(cvUrl, site.url)} class="flex h-11 items-center justify-center gap-2 rounded-control px-4 text-sm text-text-secondary underline decoration-dashed underline-offset-4 transition-colors duration-150 hover:text-text">
        {t(locale, 'recruiter.cv')}<ExternalHint href={cvUrl} locale={locale} />
      </a>
    )}
  </div>
</section>
