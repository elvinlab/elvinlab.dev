---
/** The `/experiments/` page for one locale: heading, one intro line and every experiment as a full card. */
import { loadExperiments } from '@/features/portfolio/lib/load-experiments.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import BaseLayout from '@/shared/layout/BaseLayout.astro';

import ExperimentCard from './ExperimentCard.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const experiments = await loadExperiments();
---

<BaseLayout locale={locale} path="/experiments/" title={t(locale, 'experiments.title')} description={t(locale, 'experiments.description')}>
  <section class="flex flex-col gap-6">
    <header>
      <h1 class="text-3xl font-bold tracking-tight">{t(locale, 'experiments.title')}</h1>
      <p class="mt-2 max-w-[60ch] text-text-secondary">{t(locale, 'experiments.intro')}</p>
    </header>
    {experiments.length === 0 ? (
      <p class="text-text-secondary">{t(locale, 'experiments.empty')}</p>
    ) : (
      <div class="grid items-start gap-4 sm:grid-cols-2">
        {experiments.map((experiment) => <ExperimentCard experiment={experiment} locale={locale} headingTag="h2" />)}
      </div>
    )}
  </section>
</BaseLayout>
