---
/**
 * One experiment, the full card of `/experiments/`: optional lazy screenshot, title, subtitle,
 * status, the problem, the contribution and the result, up to three tags, and text links to the live
 * site, the case (a published note) and the code. Only links that exist are shown. It carries the
 * entry id as its anchor, which the compact rows on `/me` link to.
 */
import { Image } from 'astro:assets';
import { localizePath } from '@elvinlab/core';

import { caseLinkLabelKey, experimentTagLabel, visibleExperimentTags } from '@/features/portfolio/lib/experiments.ts';
import type { ExperimentEntry } from '@/features/portfolio/lib/load-experiments.ts';
import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { resolveExperimentImage } from '@/shared/lib/experiment-image.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import { pickLocale } from '@/shared/lib/localized.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = {
  experiment: ExperimentEntry;
  locale: Locale;
  /** Heading level of the title: `h3` under a section heading, `h2` right under the page title. */
  headingTag?: 'h2' | 'h3';
};

const { experiment, locale, headingTag: Heading = 'h3' } = Astro.props;
const text = (value: ExperimentEntry['subtitle']) => pickLocale(value, locale, LOCALES.defaultLocale);
const image = experiment.image ? resolveExperimentImage(experiment.id, experiment.image.file) : undefined;
const subtitle = text(experiment.subtitle);
type FactKey = 'experiment.problem' | 'experiment.contribution' | 'experiment.result';
const facts = (
  [
    ['experiment.problem', text(experiment.problem)],
    ['experiment.contribution', text(experiment.contribution)],
    ['experiment.result', text(experiment.result)],
  ] satisfies (readonly [FactKey, string])[]
).filter(([, value]) => value !== '');
const description = text(experiment.description);
const caseHref = experiment.note
  ? localizePath(`/notes/${experiment.note}/`, experiment.noteLang ?? LOCALES.defaultLocale, LOCALES)
  : undefined;
const tags = visibleExperimentTags(experiment.tags);
const LINK = 'inline-flex min-h-11 items-center rounded-control px-3 text-sm text-primary underline decoration-dashed underline-offset-4 transition-colors duration-150 hover:bg-card-hover';
---

<article id={experiment.id} class="flex scroll-mt-24 flex-col gap-3 rounded-card bg-card p-4">
  {image && experiment.image && (
    <Image
      src={image}
      alt={pickLocale(experiment.image.alt, locale, LOCALES.defaultLocale)}
      format="webp"
      quality={80}
      width={800}
      height={500}
      widths={[400, 800]}
      sizes="(min-width: 768px) 400px, 100vw"
      loading="lazy"
      decoding="async"
      class="aspect-[16/10] w-full rounded-inner object-cover object-top outline outline-1 -outline-offset-1 outline-divider"
    />
  )}
  {!image && (
    <div class="flex aspect-[16/10] w-full flex-col justify-between rounded-inner bg-chip p-4 outline outline-1 -outline-offset-1 outline-divider" aria-hidden="true">
      <span class="font-mono text-meta text-muted">{experiment.year}</span>
      <span class="font-mono text-lg text-text-secondary text-balance">{experiment.id}</span>
    </div>
  )}
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <Heading class="font-display text-lg font-bold">{experiment.title}</Heading>
      {subtitle && <p class="text-sm text-muted">{subtitle}</p>}
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-pill bg-chip px-2 py-0.5 font-mono text-meta text-text-secondary">
      <span class:list={['size-2 rounded-pill', experiment.status === 'running' ? 'bg-ok' : 'bg-primary']} aria-hidden="true"></span>
      {t(locale, `exp.status.${experiment.status}`)}
    </span>
  </div>
  {facts.length > 0 ? (
    <dl class="flex flex-col gap-2 text-sm leading-relaxed">
      {facts.map(([key, value]) => (
        <div>
          <dt class="font-mono text-meta text-muted">{t(locale, key)}</dt>
          <dd class="text-text-secondary">{value}</dd>
        </div>
      ))}
    </dl>
  ) : (
    <p class="text-sm leading-relaxed text-text-secondary">{description}</p>
  )}
  {tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => <li class="rounded-pill bg-chip px-2.5 py-0.5 font-mono text-meta text-text-secondary">{experimentTagLabel(tag)}</li>)}
    </ul>
  )}
  {(experiment.url || caseHref || experiment.repo) && (
    <div class="-mx-3 -mb-2 mt-auto flex flex-wrap gap-x-1 print:hidden">
      {experiment.url && (
        <a href={experiment.url} {...externalLinkAttrs(experiment.url, site.url)} class={LINK}>{t(locale, 'experiment.live')}<ExternalHint href={experiment.url} locale={locale} /></a>
      )}
      {caseHref && (
        <a href={caseHref} class={LINK}>{t(locale, caseLinkLabelKey(locale, experiment.noteLang ?? LOCALES.defaultLocale))}</a>
      )}
      {experiment.repo && (
        <a href={experiment.repo} {...externalLinkAttrs(experiment.repo, site.url)} class={LINK}>{t(locale, 'experiment.code')}<ExternalHint href={experiment.repo} locale={locale} /></a>
      )}
    </div>
  )}
</article>
