---
/**
 * Mounts the banner background: one canvas, running the visitor's chosen effect (persisted in
 * localStorage via `BackgroundPicker`) or the owner's default from `site.config` when the visitor
 * has none. Purely decorative: it does nothing under prefers-reduced-motion, without WebGL2, or
 * when the resolved choice is 'off', so the banner's static grid, glows and CSS starfield remain
 * the fallback. Swaps effects live, in place, without a page reload (`BackgroundPicker` dispatches
 * a `background-change` event this script listens for).
 */
import { site } from '@/shared/config/index.ts';
---

<canvas
  data-background
  data-owner-galaxy={site.background.galaxy}
  data-owner-waves={site.background.cursorWaves}
  data-picker={site.features.backgroundPicker}
  class="absolute inset-0 -z-10 size-full motion-reduce:hidden"
></canvas>

<script>
  import { parseColor } from '@/features/backgrounds/lib/color.ts';
  import type { Background, BackgroundHandle } from '@/features/backgrounds/lib/contract.ts';
  import { createCursorWaves } from '@/features/backgrounds/lib/cursor-waves.ts';
  import { createGalaxy } from '@/features/backgrounds/lib/galaxy.ts';
  import { createGlContext } from '@/features/backgrounds/lib/gl-runner.ts';
  import { createPageLifecycle } from '@/features/backgrounds/lib/page-lifecycle.ts';
  import type { BackgroundChoice } from '@/shared/lib/background-preference.ts';
  import {
    BACKGROUND_STORAGE_KEY,
    ownerDefaultChoice,
    resolveBackgroundChoice,
  } from '@/shared/lib/background-preference.ts';

  const factories: Record<Exclude<BackgroundChoice, 'off'>, Background> = {
    galaxy: createGalaxy,
    'cursor-waves': createCursorWaves,
  };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-background]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarsePointer = matchMedia('(pointer: coarse)').matches;
  if (canvas && !reduced && !coarsePointer && 'WebGL2RenderingContext' in window) {
    const ownerDefault = ownerDefaultChoice({
      galaxy: canvas.dataset['ownerGalaxy'] === 'true',
      cursorWaves: canvas.dataset['ownerWaves'] === 'true',
    });

    const readPalette = () => {
      const styles = getComputedStyle(document.documentElement);
      const token = (name: string) => parseColor(styles.getPropertyValue(name).trim());
      return {
        base: token('--ui-banner'),
        primary: token('--ui-primary'),
        cyan: token('--ui-cyan'),
        pink: token('--ui-pink'),
      };
    };

    let handle: BackgroundHandle | null = null;
    // One context for the canvas's whole lifetime: swapping effects recompiles a program on it
    // rather than opening a new context each time (Firefox especially enforces a low limit on
    // concurrent WebGL contexts, so repeated open/close on one canvas can lose the context).
    let gl: WebGL2RenderingContext | null = null;

    const stop = (): void => {
      handle?.destroy();
      handle = null;
    };

    const run = (choice: BackgroundChoice): void => {
      stop();
      // 'off' hides the canvas so the banner's CSS starfield fallback shows through underneath.
      canvas.style.display = choice === 'off' ? 'none' : '';
      if (choice === 'off') return;
      if (!gl) {
        gl = createGlContext(canvas);
        // preventDefault lets the browser restore the context later. Meanwhile the canvas stays
        // hidden so a lost context never paints the browser's broken-canvas icon; the restored
        // event rebuilds the program (`run` stops the old handle first, then the factory recompiles).
        canvas.addEventListener('webglcontextlost', (event) => {
          event.preventDefault();
          canvas.style.display = 'none';
        });
        canvas.addEventListener('webglcontextrestored', () => run(current()));
      }
      if (!gl) return;
      if (gl.isContextLost()) {
        canvas.style.display = 'none';
        return;
      }
      handle = factories[choice](gl, canvas, readPalette());
    };

    let stored: string | null = null;
    try {
      // Without the picker nobody can choose: a choice saved earlier is ignored, the owner default rules.
      if (canvas.dataset['picker'] !== 'false') stored = localStorage.getItem(BACKGROUND_STORAGE_KEY);
    } catch {
      // Storage can be blocked (privacy modes); fall back to the owner default for this view.
    }
    // Reading mode stops the effect without touching the visitor's saved choice.
    let choice = resolveBackgroundChoice(stored, ownerDefault);
    const reading = (): boolean => document.documentElement.hasAttribute('data-reading');
    const current = (): BackgroundChoice => (reading() ? 'off' : choice);
    run(current());

    // Recolor the running effect in place on theme change — rebuilding a GL context would lose it.
    const themeObserver = new MutationObserver(() => {
      if (handle) handle.setPalette(readPalette());
    });
    themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });

    document.addEventListener('background-change', (event) => {
      choice = (event as CustomEvent<BackgroundChoice>).detail;
      run(current());
    });
    document.addEventListener('reading-mode-change', () => run(current()));

    const dispose = (): void => {
      stop();
      themeObserver.disconnect();
      // Only here, leaving the page for good, does the context itself get released.
      if (gl && !gl.isContextLost()) gl.getExtension('WEBGL_lose_context')?.loseContext();
    };
    document.addEventListener('astro:before-swap', dispose, { once: true });
    // Entering the back/forward cache only pauses (the context must survive a Back restore);
    // coming back re-runs the effect, or leaves the canvas hidden if the browser lost the context.
    const lifecycle = createPageLifecycle({ pause: stop, resume: () => run(current()), dispose });
    window.addEventListener('pagehide', lifecycle.onPageHide);
    window.addEventListener('pageshow', lifecycle.onPageShow);
  }
</script>

<style>
  @media (pointer: coarse) {
    canvas[data-background] {
      display: none;
    }
  }
</style>
