---
/**
 * Mounts the configured banner background (site.config `background`) with its palette sampled from
 * the active theme's tokens. Purely decorative: it does nothing under prefers-reduced-motion, without
 * WebGL2, or when the effect is "none", so the banner's static grid and glows remain the fallback.
 */
import { site } from '@/shared/config/index.ts';

const effect = site.background;
---

{effect !== 'none' && (
  <canvas data-background data-effect={effect} class="absolute inset-0 -z-10 size-full motion-reduce:hidden"></canvas>
)}

<script>
  import { parseColor } from '@/features/backgrounds/lib/color.ts';
  import type { Background } from '@/features/backgrounds/lib/contract.ts';
  import { createCursorWaves } from '@/features/backgrounds/lib/cursor-waves.ts';
  import { createGalaxy } from '@/features/backgrounds/lib/galaxy.ts';

  const effects: Record<string, Background> = {
    'cursor-waves': createCursorWaves,
    galaxy: createGalaxy,
  };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-background]');
  const create = canvas ? effects[canvas.dataset['effect'] ?? ''] : undefined;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && create && !reduced && 'WebGL2RenderingContext' in window) {
    const readPalette = () => {
      const styles = getComputedStyle(document.documentElement);
      const token = (name: string) => parseColor(styles.getPropertyValue(name).trim());
      return {
        base: token('--ui-banner'),
        primary: token('--ui-primary'),
        cyan: token('--ui-cyan'),
        pink: token('--ui-pink'),
      };
    };

    const background = create(canvas, readPalette());

    // Recolor in place on theme change — rebuilding the GL context would lose it (broken canvas).
    const observer = new MutationObserver(() => background.setPalette(readPalette()));
    observer.observe(document.documentElement, { attributeFilter: ['data-theme'] });

    const dispose = () => {
      background.destroy();
      observer.disconnect();
    };
    document.addEventListener('astro:before-swap', dispose, { once: true });
    window.addEventListener('pagehide', dispose, { once: true });
  }
</script>
