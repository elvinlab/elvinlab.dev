---
/**
 * Contact page component: renders the locale-specific contact content with the form island.
 */

import { ContactForm } from '@/features/contact/components/ContactForm.tsx';
import { buildContactContent } from '@/features/contact/content.ts';
import { integrations, site } from '@/shared/config/index.ts';
import type { Locale } from '@/shared/i18n/index.ts';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import ExternalHint from '@/shared/ui/ExternalHint.astro';
import SocialIcon from '@/shared/ui/SocialIcon.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const content = buildContactContent()[locale];
const siteKey = integrations.turnstileSiteKey;
const linkedin = site.socials.find((social) => social.icon === 'linkedin');
---

<BaseLayout locale={locale} path="/contact/" title={content.pageTitle} description={content.pageDescription}>
  <article class="max-w-xl">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{content.pageTitle}</h1>
      <p class="mt-2 text-text-secondary">{content.pageDescription}</p>
    </header>

    <ContactForm client:visible siteKey={siteKey} strings={content.form} />

    {linkedin && (
      <p class="mt-6 flex flex-wrap items-center gap-x-2 text-sm text-text-secondary">
        <span>{content.linkedin}</span>
        <a
          href={linkedin.url}
          {...externalLinkAttrs(linkedin.url, site.url, 'me')}
          class="inline-flex h-11 items-center gap-2 rounded-control px-3 text-text transition-colors duration-150 hover:bg-card-hover"
        >
          <SocialIcon name={linkedin.icon} />
          {linkedin.label}<ExternalHint href={linkedin.url} locale={locale} />
        </a>
      </p>
    )}

    <noscript>
      <p class="mt-6 text-sm text-muted">{content.noscript}</p>
    </noscript>
  </article>
</BaseLayout>