---
/** /changelog page: lists every entry, newest first. The route exists only while `features.changelog` is on. */
import { getCollection } from 'astro:content';

import { sortChangelog } from '@/features/changelog/lib/changelog.ts';
import type { Locale } from '@/shared/i18n/index.ts';
import BaseLayout from '@/shared/layout/BaseLayout.astro';

import ChangelogList from './ChangelogList.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const path = locale === 'es' ? '/changelog/' : '/en/changelog/';
const title = 'Changelog';
const description =
  locale === 'es' ? 'Registro de cambios visibles del sitio.' : 'Log of visible site changes.';

const entries = sortChangelog(await getCollection('changelog')).map((entry) => entry.data);
---

<BaseLayout locale={locale} path={path} title={title} description={description}>
  <article class="max-w-none">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
      <p class="mt-2 text-muted">{description}</p>
    </header>
    <ChangelogList entries={entries} locale={locale} />
  </article>
</BaseLayout>
