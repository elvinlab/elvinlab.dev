---
/** Dated list of changelog entries, newest first (already sorted by the caller). */

import { formatChangelogDate } from '@/features/changelog/lib/changelog.ts';
import type { ChangelogEntry } from '@/features/changelog/schema.ts';
import type { Locale } from '@/shared/i18n/index.ts';

type Props = { entries: ChangelogEntry[]; locale: Locale };

const { entries, locale } = Astro.props;
---

<ul class="space-y-6">
  {entries.map((entry) => (
    <li class="border-b border-dashed border-divider pb-6 last:border-b-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-pill bg-chip px-2 py-0.5 font-mono text-meta uppercase text-primary">
          {entry.category}
        </span>
        <time datetime={entry.date.toISOString()} class="text-sm text-muted">
          {formatChangelogDate(entry.date, locale)}
        </time>
      </div>
      <h3 class="mt-2 font-semibold text-text">{entry.title}</h3>
      {entry.description && <p class="mt-1 text-sm leading-relaxed text-text-secondary">{entry.description}</p>}
    </li>
  ))}
</ul>
