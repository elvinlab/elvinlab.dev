---
import { getCollection } from 'astro:content';

import { NotePage } from '@/features/notes/index.ts';
import { ExperimentNudge } from '@/features/portfolio/index.ts';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (note) => note.data.lang === 'es');
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<NotePage entry={entry} locale="es">
  <ExperimentNudge slot="end" locale="es" class="xn-spaced" floating />
</NotePage>
