---
/**
 * The subscription form and its status line, shared by the footer band and the `/subscribe/` page.
 * It ships the markup and a stub of a few lines; the form logic and Turnstile load on the first
 * focus or pointer enter, so a page that nobody interacts with pays no script and no third-party
 * request (LCP budget). The nearest `[data-subscribe]` ancestor is the root that carries the texts
 * (`subscribe-root.ts`).
 */
import { localizePath } from '@elvinlab/core';

import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { SUBSCRIBE_CLIENT_POLICY } from '@/shared/subscribe/client-policy.ts';

type Props = {
  locale: Locale;
  /** `page` adds the reassurance line and quiets the privacy link (the `/subscribe/` page). */
  variant?: 'band' | 'page';
};

const { locale, variant = 'band' } = Astro.props;
const privacyHref = `${localizePath('/privacy/', locale, LOCALES)}#subscribe`;
const page = variant === 'page';
---

<form class="relative flex flex-col gap-2" novalidate>
  <label for="subscribe-email" class="text-sm font-medium text-text">{t(locale, 'subscribe.email')}</label>
  <div class="flex flex-col gap-3 sm:flex-row">
    <div class="relative min-w-0 sm:flex-1">
      <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center font-mono text-sm text-pink">&gt;</span>
      <input
        id="subscribe-email"
        name="email"
        type="email"
        inputmode="email"
        required
        autocomplete="email"
        autocapitalize="none"
        spellcheck="false"
        placeholder={t(locale, 'subscribe.placeholder')}
        maxlength={SUBSCRIBE_CLIENT_POLICY.emailMaxLength}
        class="h-11 w-full min-w-0 rounded-control border border-divider bg-page pr-3 pl-8 font-mono text-sm text-text placeholder:text-muted hover:border-primary/60 focus-visible:border-primary"
      />
    </div>
    <button type="submit" class="h-11 shrink-0 rounded-control bg-button px-5 font-medium text-white hover:bg-button/90 hover:translate-y-px active:translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transition-none">
      {t(locale, 'subscribe.submit')}
    </button>
  </div>
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <input type="text" name="homepage" tabindex="-1" autocomplete="off" />
  </div>
</form>
<div data-widget class="w-full empty:hidden"></div>
<p role="status" aria-live="polite" class="text-sm text-text-secondary empty:sr-only" data-status></p>
<noscript><p class="text-sm text-text-secondary">{t(locale, 'subscribe.noscript')}</p></noscript>
{page && <p class="mt-1 text-meta text-muted">{t(locale, 'subscribe.page.reassurance')}</p>}
<a
  href={privacyHref}
  class:list={[
    'inline-flex h-11 w-fit items-center underline decoration-dashed underline-offset-4',
    page ? 'text-meta text-muted hover:text-text' : 'text-sm text-primary',
  ]}
>{t(locale, 'subscribe.privacy')}</a>

<script>
  // Stub: the real form logic is fetched on the first interaction, never on page load.
  const root = document.querySelector<HTMLElement>('[data-subscribe]');
  const form = root?.querySelector('form');
  if (root && form) {
    let armed = false;
    let queued = false;
    const onSubmit = (event: Event) => {
      // Submitted before the logic arrived: hold it and replay once the real handler is attached.
      event.preventDefault();
      queued = true;
    };
    const arm = () => {
      if (armed) return;
      armed = true;
      void import('@/shared/subscribe/form-client.ts').then((m) => {
        m.initSubscribeForm(root);
        form.removeEventListener('submit', onSubmit);
        if (queued) form.requestSubmit();
      });
    };
    form.addEventListener('focusin', arm, { once: true });
    form.addEventListener('pointerenter', arm, { once: true });
    form.addEventListener('submit', onSubmit);
    form.addEventListener('submit', arm);
  }
</script>
