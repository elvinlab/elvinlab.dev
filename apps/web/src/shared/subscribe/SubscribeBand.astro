---
/**
 * The footer subscription band: the form on every page except the subscription pages themselves.
 * The form, its stub script and the lazy loading of the logic live in `SubscribeForm.astro`.
 */
import type { Locale } from '@/shared/i18n/index.ts';
import { t } from '@/shared/i18n/index.ts';
import PixelEnvelope from '@/shared/subscribe/PixelEnvelope.astro';
import SubscribeForm from '@/shared/subscribe/SubscribeForm.astro';
import { subscribeRootAttributes } from '@/shared/subscribe/subscribe-root.ts';

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<section
  data-subscribe-cta
  {...subscribeRootAttributes(locale)}
  class="group/cta mb-8 flex flex-col gap-5 rounded-control border border-dashed border-divider bg-card p-5 md:flex-row md:items-start md:justify-between md:gap-8"
>
  <div class="flex items-start gap-4 md:max-w-[28rem]">
    <PixelEnvelope width={36} height={28} class="mt-1 shrink-0 motion-safe:transition-transform motion-safe:duration-200 motion-safe:[transition-timing-function:steps(2,end)] motion-safe:group-hover/cta:-translate-y-1 motion-safe:group-focus-within/cta:-translate-y-1" />
    <div class="flex flex-col gap-1">
      <h2 class="font-display text-lg font-bold">{t(locale, 'subscribe.title')}</h2>
      <p class="text-sm text-text-secondary">{t(locale, 'subscribe.body')}</p>
    </div>
  </div>
  <div class="flex w-full flex-col gap-2 md:max-w-[26rem]">
    <SubscribeForm locale={locale} />
  </div>
</section>
