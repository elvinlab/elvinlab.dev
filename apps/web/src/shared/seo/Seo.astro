---
/**
 * Every page's head metadata, driven by site config: title, description, canonical, hreflang
 * alternates, Open Graph, Twitter, theme color and favicon.
 */

import { getCollection } from 'astro:content';
import { localizePath, tokens } from '@elvinlab/core';

import { buildEnv, site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { hasPublishedNotes } from '@/shared/lib/notes-helpers.ts';
import { blogPostingJsonLd, breadcrumbJsonLd, jsonLdScript, type PageType, pageJsonLd, personJsonLd, websiteJsonLd } from '@/shared/seo/jsonld.ts';
import { seoLinks } from '@/shared/seo/links.ts';
import { articleMetaTags, DEFAULT_OG_IMAGE, ogLocale } from '@/shared/seo/og.ts';

type Props = {
  locale: Locale;
  /** Route path without locale prefix, e.g. `/notes/`. */
  path: string;
  /** Page title; the site title is appended. Omit on the home page. */
  title?: string;
  description?: string | undefined;
  /** False for pages that exist in one locale only. */
  translated?: boolean;
  noindex?: boolean;
  /** When set, emits BlogPosting structured data and `article:*` tags for a note. */
  article?: { pubDate: Date; updatedDate?: Date | undefined; tags?: readonly string[] | undefined };
  /** Explicit hreflang alternates (absolute URLs), for pages whose translation lives at another slug. */
  alternates?: { hreflang: string; href: string }[];
  /** Site path of this page's share image; the default card is used when omitted. */
  ogImage?: string;
  /** schema.org type of the page, for pages that are not a note: adds its structured data node. */
  pageType?: PageType;
  /** Topics of the page (an experiment's stack), written to its structured data. */
  keywords?: readonly string[];
  /** Parents between the home and this page in its breadcrumb (`{ name, path }`, path without locale prefix). */
  trail?: readonly { name: string; path: string }[];
  /** Alt text for the share image; defaults to the page title (or the owner's name on the default card). */
  ogImageAlt?: string;
};

const { locale, path, title, description, translated = true, noindex = false, article, alternates, ogImage: ogImagePath, ogImageAlt: ogImageAltProp, pageType, keywords, trail = [] } = Astro.props;
const siteIndexable = buildEnv.siteIndexable;
const fullTitle = title && title !== site.title ? `${title} · ${site.title}` : site.title;
// Link previews cut long titles (about 70 characters), so an article's preview title drops the site
// suffix: `og:site_name` carries it and the share card draws the domain.
const socialTitle = article && title ? title : fullTitle;
const summary = description ?? site.description[locale] ?? site.description[LOCALES.defaultLocale] ?? site.title;
const noteEntries = await getCollection('notes');
const notes = noteEntries.map((entry) => ({ slug: entry.id, data: entry.data }));
// The feed route exists only with `features.blog`: advertising it without the blog is a dead link.
const showRss = site.features.blog && hasPublishedNotes(notes);
const links = seoLinks({
  path,
  locale,
  site: new URL(site.url),
  locales: LOCALES,
  translated,
});
const ogImage = new URL(ogImagePath ?? DEFAULT_OG_IMAGE, site.url).toString();
const ogImageAlt = ogImageAltProp ?? (ogImagePath ? fullTitle : `${site.identity.name} · ${site.identity.role[locale] ?? site.title}`);
const absolute = (target: string): string => new URL(localizePath(target, locale, LOCALES), site.url).href;
// Every page below the home gets a breadcrumb: Google shows it instead of the raw URL in the result.
const breadcrumb =
  path === '/' || noindex
    ? undefined
    : breadcrumbJsonLd([
        { name: t(locale, 'nav.home'), url: absolute('/') },
        ...trail.map((step) => ({ name: step.name, url: absolute(step.path) })),
        { name: title ?? site.title, url: links.canonical },
      ]);
const pageNode = pageType
  ? pageJsonLd(pageType, { site, locale, url: links.canonical, name: title ?? site.title, description: summary, keywords, image: ogImage })
  : undefined;
// First theme of each scheme colors the browser UI to match the page.
const themeColors = ['dark', 'light'].flatMap((scheme) => {
  const theme = Object.values(tokens.themes).find((candidate) => candidate.scheme === scheme);
  return theme ? [{ scheme, color: theme.colors['page'] }] : [];
});
---

<title>{fullTitle}</title>
<meta name="description" content={summary} />
{(!siteIndexable || noindex) && <meta name="robots" content="noindex" />}
<link rel="canonical" href={links.canonical} />
{(alternates ?? links.alternates).map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
{showRss && <link rel="alternate" type="application/rss+xml" title={`${site.title} · Lab Notes`} href="/rss.xml" />}
{themeColors.map(({ scheme, color }) => <meta name="theme-color" media={`(prefers-color-scheme: ${scheme})`} content={color} />)}
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={summary} />
<meta property="og:url" content={links.canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<meta property="og:locale" content={ogLocale(locale)} />
{article && articleMetaTags(article).map((tag) => <meta property={tag.property} content={tag.content} />)}
<script type="application/ld+json" is:inline set:html={jsonLdScript(websiteJsonLd(site, summary))} />
<script type="application/ld+json" is:inline set:html={jsonLdScript(personJsonLd(site, locale))} />
{pageNode && <script type="application/ld+json" is:inline set:html={jsonLdScript(pageNode)} />}
{breadcrumb && <script type="application/ld+json" is:inline set:html={jsonLdScript(breadcrumb)} />}
{article && (
  <script
    type="application/ld+json"
    is:inline
    set:html={jsonLdScript(blogPostingJsonLd({ site, locale, url: links.canonical, title: title ?? site.title, description: summary, pubDate: article.pubDate, updatedDate: article.updatedDate, image: ogImage }))}
  />
)}
