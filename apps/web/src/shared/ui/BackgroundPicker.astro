---
/**
 * Cycles the banner background effect (galaxy -> cursor-waves -> off) and remembers the choice,
 * the same way `ThemeToggle` works. The galaxy icon is a sparkle so it never reads as the theme
 * toggle's sun. The 'off' state is the static lab paper, so its icon is a grid, not a "disabled"
 * sign. Dispatches `background-change` so `BackgroundCanvas` swaps the
 * running effect in place, without a page reload. Hidden (CSS only) under a coarse pointer and
 * under prefers-reduced-motion, the two conditions where `BackgroundCanvas` never runs an effect,
 * so the button never promises a change the visitor cannot see. Width never hides it.
 * Its accessible name carries the current mode ("Change background: galaxy") and a visually hidden
 * polite text repeats the new name after each click, so the change is announced.
 */
import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import { BACKGROUND_STORAGE_KEY, ownerDefaultChoice } from '@/shared/lib/background-preference.ts';

type Props = { label: string; locale: Locale };

const { label, locale } = Astro.props;
const modes = {
  galaxy: t(locale, 'background.galaxy'),
  'cursor-waves': t(locale, 'background.waves'),
  off: t(locale, 'background.off'),
};
const startMode = ownerDefaultChoice({
  galaxy: site.background.galaxy,
  cursorWaves: site.background.cursorWaves,
});
---

<button
  type="button"
  class="grid size-11 shrink-0 place-items-center text-text motion-reduce:hidden pointer-coarse:hidden"
  aria-label={`${label}: ${modes[startMode]}`}
  data-background-toggle
  data-label={label}
  data-modes={JSON.stringify(modes)}
  data-storage-key={BACKGROUND_STORAGE_KEY}
  data-owner-galaxy={site.background.galaxy}
  data-owner-waves={site.background.cursorWaves}
>
  <svg data-icon="galaxy" viewBox="0 0 10 10" width="20" height="20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M4 0h2v3H4zM2 3h6v1H2zM0 4h10v2H0zM2 6h6v1H2zM4 7h2v3H4z"></path></svg>
  <svg data-icon="cursor-waves" class="hidden" viewBox="0 0 10 10" width="20" height="20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M1 0h2v1H1zM7 0h2v1H7zM0 1h4v1H0zM6 1h4v1H6zM0 2h1v1H0zM3 2h4v1H3zM9 2h1v1H9zM4 3h2v1H4zM1 6h2v1H1zM7 6h2v1H7zM0 7h4v1H0zM6 7h4v1H6zM0 8h1v1H0zM3 8h4v1H3zM9 8h1v1H9zM4 9h2v1H4z"></path></svg>
  <svg data-icon="off" class="hidden" viewBox="0 0 10 10" width="20" height="20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h10v1H0zM0 3h10v1H0zM0 6h10v1H0zM0 9h10v1H0zM0 0h1v10H0zM3 0h1v10H3zM6 0h1v10H6zM9 0h1v10H9z"></path></svg>
</button>
<span class="sr-only" aria-live="polite" data-background-status></span>

<script>
  import {
    type BackgroundChoice,
    nextBackgroundChoice,
    ownerDefaultChoice,
    resolveBackgroundChoice,
  } from '@/shared/lib/background-preference.ts';

  /** Puts the current mode in the accessible name; returns the name so a click can announce it. */
  const syncName = (button: HTMLElement, choice: BackgroundChoice): string => {
    const modes = JSON.parse(button.dataset['modes'] ?? '{}') as Record<string, string>;
    const name = `${button.dataset['label'] ?? ''}: ${modes[choice] ?? choice}`;
    button.setAttribute('aria-label', name);
    return name;
  };

  const syncIcon = (button: HTMLElement, choice: BackgroundChoice): void => {
    for (const icon of button.querySelectorAll<SVGElement>('[data-icon]')) {
      icon.classList.toggle('hidden', icon.dataset['icon'] !== choice);
    }
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-background-toggle]')) {
    const storageKey = button.dataset['storageKey'] ?? 'background';
    const ownerDefault = ownerDefaultChoice({
      galaxy: button.dataset['ownerGalaxy'] === 'true',
      cursorWaves: button.dataset['ownerWaves'] === 'true',
    });

    let stored: string | null = null;
    try {
      stored = localStorage.getItem(storageKey);
    } catch {
      // Storage can be blocked (privacy modes); the picker still works for this page view.
    }
    let current = resolveBackgroundChoice(stored, ownerDefault);
    syncIcon(button, current);
    syncName(button, current);

    button.addEventListener('click', () => {
      current = nextBackgroundChoice(current);
      try {
        localStorage.setItem(storageKey, current);
      } catch {
        // Storage can be blocked (privacy modes); the effect still swaps for this page view.
      }
      syncIcon(button, current);
      const status = button.nextElementSibling;
      if (status instanceof HTMLElement) status.textContent = syncName(button, current);
      document.dispatchEvent(new CustomEvent('background-change', { detail: current }));
    });
  }
</script>
