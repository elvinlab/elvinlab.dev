---
/**
 * "Showing 13-24 of 27": where the current page sits in the whole list. Renders nothing for an
 * empty list. Generic and quiet; the stylesheet is emitted by this component only when it renders (`listing-styles.ts`).
 */
import { type Locale, t } from '@/shared/i18n/index.ts';

import { SUMMARY_CSS } from './listing-styles.ts';

type Props = { locale: Locale; from: number; to: number; total: number };

const { locale, from, to, total } = Astro.props;
---

{total > 0 && (
  <>
  <style is:inline set:html={SUMMARY_CSS} />
  <p class="lk-summary" data-listing-summary>{t(locale, 'listing.summary', { from, to, total })}</p>
  </>
)}
