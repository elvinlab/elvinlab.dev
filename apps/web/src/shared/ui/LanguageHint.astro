---
/**
 * Quiet, dismissible line of text shown on default-locale pages when the browser prefers another
 * supported locale. It never nags the other way (a visitor already on /en/ chose it, and the
 * navbar always offers the switch) and never redirects: crawlers must reach every locale. It stays
 * in document flow after the site chrome so it never covers reading content or keyboard focus.
 */
import { localizePath, switchLocale } from '@elvinlab/core';

import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { isSingleLocaleRoute } from '@/shared/layout/nav.ts';

type Props = { locale: Locale; translations?: Record<string, string> | undefined };

const { locale, translations } = Astro.props;
// The notes index is Spanish-only; note translations are optional, so suggest the other locale's home.
const routePath = switchLocale(Astro.url.pathname, LOCALES.defaultLocale, LOCALES);
const alternates = LOCALES.locales
  .filter((other) => other !== locale)
  .map((other) => ({
    locale: other,
    href:
      translations?.[other] ??
      (isSingleLocaleRoute(routePath)
        ? localizePath('/', other, LOCALES)
        : switchLocale(Astro.url.pathname, other, LOCALES)),
    text: t(other, 'language.hint'),
    action: t(other, 'language.hint.action'),
    dismiss: t(other, 'language.hint.dismiss'),
  }));
---

{
  alternates.map((alternate) => (
    <aside
      hidden
      lang={alternate.locale}
      data-language-hint={alternate.locale}
      data-current-locale={locale}
      data-default-locale={LOCALES.defaultLocale}
      aria-label={alternate.text}
      class="mx-auto mt-2 flex items-center justify-center gap-1 text-xs text-muted"
    >
      <span>{alternate.text}</span>
      <a href={alternate.href} hreflang={alternate.locale} class="flex min-h-11 items-center px-1 underline decoration-dashed underline-offset-4 transition-colors duration-150 hover:text-text">
        {alternate.action}
      </a>
      <button type="button" data-language-hint-dismiss class="grid size-11 place-items-center rounded-control text-muted transition-colors duration-150 hover:text-text" aria-label={alternate.dismiss}>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </aside>
  ))
}

<script>
  import { suggestLocale } from '@elvinlab/core/i18n';

  const DISMISSED_KEY = 'language-hint-dismissed';

  const isDismissed = (): boolean => {
    try {
      return localStorage.getItem(DISMISSED_KEY) === '1';
    } catch {
      return false;
    }
  };

  const hints = [...document.querySelectorAll<HTMLElement>('[data-language-hint]')];
  const current = hints[0]?.dataset['currentLocale'];
  const locales = [current, ...hints.map((hint) => hint.dataset['languageHint'])].filter(
    (value): value is string => Boolean(value),
  );
  // Only default-locale pages suggest the other language; /en/ pages never do.
  const onDefaultLocale = current !== undefined && current === hints[0]?.dataset['defaultLocale'];
  const suggested =
    current && onDefaultLocale && !isDismissed()
      ? suggestLocale({ preferred: navigator.languages, current, locales })
      : null;
  const hint = hints.find((element) => element.dataset['languageHint'] === suggested);

  if (hint) {
    hint.hidden = false;
    hint.querySelector('[data-language-hint-dismiss]')?.addEventListener('click', () => {
      hint.hidden = true;
      try {
        localStorage.setItem(DISMISSED_KEY, '1');
      } catch {
        // Storage can be blocked; the hint simply shows again on the next visit.
      }
    });
  }
</script>
