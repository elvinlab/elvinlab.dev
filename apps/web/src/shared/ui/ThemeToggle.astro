---
/**
 * Cycles through the themes defined in tokens.json and remembers the choice. Works without a
 * framework: the pre-paint script in <head> applies the saved theme, this button only changes it.
 */
import { DEFAULT_THEME, THEME_STORAGE_KEY, THEMES } from '@elvinlab/core';

type Props = { label: string };

const { label } = Astro.props;
const startsDark = (THEMES.find((theme) => theme.name === DEFAULT_THEME)?.scheme ?? 'dark') === 'dark';
---

<button
  type="button"
  class="grid size-11 shrink-0 place-items-center text-text"
  aria-label={label}
  aria-pressed={startsDark ? 'true' : 'false'}
  data-theme-toggle
  data-themes={JSON.stringify(THEMES)}
  data-storage-key={THEME_STORAGE_KEY}
>
  <svg data-icon="dark" viewBox="0 0 10 10" width="20" height="20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M3 0h2v1H3zM2 1h3v1H2zM1 2h3v1H1zM0 3h4v3H0zM0 6h5v1H0zM1 7h8v1H1zM2 8h6v1H2zM3 9h4v1H3z"></path></svg>
  <svg data-icon="light" class="hidden" viewBox="0 0 10 10" width="20" height="20" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M4 0h2v1H4zM1 1h1v1H1zM8 1h1v1H8zM3 2h4v1H3zM2 3h6v4H2zM0 4h1v2H0zM9 4h1v2H9zM3 7h4v1H3zM1 8h1v1H1zM8 8h1v1H8zM4 9h2v1H4z"></path></svg>
</button>

<script>
  import type { ThemeOption } from '@elvinlab/core';

  const root = document.documentElement;

  /** Browser UI color follows the page theme; overrides both scheme-scoped tags, which stay as the no-JS fallback. */
  const syncThemeColor = (): void => {
    const color = getComputedStyle(root).getPropertyValue('--color-page').trim();
    for (const meta of document.querySelectorAll('meta[name=theme-color]')) meta.setAttribute('content', color);
  };

  /** Applies a theme without letting every color transition fire at once (the switch snaps). */
  const applyTheme = (name: string): void => {
    const freeze = document.createElement('style');
    freeze.textContent = '*,*::before,*::after{transition:none!important}';
    document.head.append(freeze);
    root.setAttribute('data-theme', name);
    void root.offsetHeight;
    syncThemeColor();
    requestAnimationFrame(() => freeze.remove());
  };

  const syncIcon = (button: HTMLElement, themes: ThemeOption[]): void => {
    const current = themes.find((theme) => theme.name === root.getAttribute('data-theme'));
    const scheme = current?.scheme ?? 'dark';
    button.setAttribute('aria-pressed', String(scheme === 'dark'));
    for (const icon of button.querySelectorAll<SVGElement>('[data-icon]')) {
      icon.classList.toggle('hidden', icon.dataset['icon'] !== scheme);
    }
  };

  syncThemeColor();
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const themes = JSON.parse(button.dataset['themes'] ?? '[]') as ThemeOption[];
    const storageKey = button.dataset['storageKey'] ?? 'theme';
    syncIcon(button, themes);
    button.addEventListener('click', () => {
      const index = themes.findIndex((theme) => theme.name === root.getAttribute('data-theme'));
      const next = themes[(index + 1) % themes.length];
      if (!next) return;
      applyTheme(next.name);
      try {
        localStorage.setItem(storageKey, next.name);
      } catch {
        // Storage can be blocked (privacy modes); the theme still applies for this page view.
      }
      syncIcon(button, themes);
    });
  }
</script>
