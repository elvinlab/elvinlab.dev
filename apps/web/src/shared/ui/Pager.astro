---
/**
 * The page navigation of a listing: Previous and Next at the ends, numbered links in between (a
 * window with an ellipsis beyond seven pages, always keeping the first and the last page) and the
 * current page as plain text with `aria-current="page"`. Real links only, so every page stays a
 * crawlable URL. It renders nothing while the list has one page. Generic: it knows nothing about
 * what is listed, the page passes the model (`pages`, `current`), `href` and the accessible name.
 * The stylesheet is emitted as a string by this component only when it renders (`listing-styles.ts`).
 */
import { type Locale, t } from '@/shared/i18n/index.ts';
import { pageWindow } from '@/shared/lib/listing.ts';

import { PAGER_CSS } from './listing-styles.ts';

type Props = {
  locale: Locale;
  page: number;
  pages: number;
  /** Locale-aware URL of a page of this listing. */
  href: (page: number) => string;
  /** Accessible name of the navigation; a generic one is used when omitted. */
  label?: string;
};

const { locale, page, pages, href, label = t(locale, 'listing.pager.label') } = Astro.props;
const items = pageWindow(page, pages);
const arrow = 'M8 4h1v1H8zM7 3h1v3H7zM6 2h1v5H6zM5 1h1v7H5zM0 3h5v3H0z';
---

{pages > 1 && (
  <>
  <style is:inline set:html={PAGER_CSS} />
  <nav class="lk-pager" aria-label={label} data-listing-nav>
    {page > 1 ? (
      <a class="lk-step lk-prev" href={href(page - 1)} rel="prev">
        <svg class="lk-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
        {t(locale, 'listing.pager.prev')}
      </a>
    ) : <span class="lk-step-gap" aria-hidden="true"></span>}
    <ul class="lk-pages">
      {items.map((item) => (
        <li>
          {item.kind === 'ellipsis' ? (
            <span class="lk-num lk-gap" aria-hidden="true">…</span>
          ) : item.page === page ? (
            <span class="lk-num lk-current" aria-current="page">{item.page}</span>
          ) : (
            <a class="lk-num" href={href(item.page)} aria-label={t(locale, 'listing.pager.goto', { page: item.page })}>{item.page}</a>
          )}
        </li>
      ))}
    </ul>
    {page < pages ? (
      <a class="lk-step lk-next" href={href(page + 1)} rel="next">
        {t(locale, 'listing.pager.next')}
        <svg class="lk-arrow" viewBox="0 0 9 9" width="18" height="18" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true" focusable="false"><path d={arrow}></path></svg>
      </a>
    ) : <span class="lk-step-gap" aria-hidden="true"></span>}
  </nav>
  </>
)}
