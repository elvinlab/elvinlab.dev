---
/**
 * Temporary home body until the real home lands (T14). Keeps the build-time image check alive:
 * CI asserts that at least one optimized WebP is emitted.
 */
import { Image } from 'astro:assets';

import skeletonCheck from '@/assets/skeleton-check.png';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Card from '@/shared/ui/Card.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<Card as="section" class="flex flex-col items-start gap-4">
  <Image src={skeletonCheck} alt="" width={96} height={64} class="rounded-inner" />
  <h1 class="font-display text-3xl font-bold md:text-4xl">{t(locale, 'placeholder.title')}</h1>
  <p class="text-text-secondary">{t(locale, 'placeholder.body')}</p>
</Card>
