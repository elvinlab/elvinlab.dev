---
/**
 * Page shell: head metadata, pre-paint theme script, skip link, navbar, content, footer and the
 * language hint. Pages pass an `aside` slot to get the design's `main | sidebar 280 px` grid (only
 * while the slot renders something) and a `banner` slot for the full-bleed banner above it.
 */
import '@/styles/fonts.css';
import '@/styles/global.css';


import { DEFAULT_THEME } from '@elvinlab/core';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import pixelifySansLatin from '@fontsource-variable/pixelify-sans/files/pixelify-sans-latin-wght-normal.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

import { appearance, integrations, site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Footer from '@/shared/layout/Footer.astro';
import Navbar from '@/shared/layout/Navbar.astro';
import SiteNotice from '@/shared/layout/SiteNotice.astro';
import { showSubscribeCta, showSubscribeLink } from '@/shared/layout/subscribe-cta.ts';
import { themeBootScript } from '@/shared/layout/theme-boot.ts';
import Seo from '@/shared/seo/Seo.astro';
import BackToTop from '@/shared/ui/BackToTop.astro';
import LanguageHint from '@/shared/ui/LanguageHint.astro';

type Props = {
  locale: Locale;
  /** Route path without locale prefix, e.g. `/notes/`. */
  path: string;
  title?: string;
  description?: string;
  translated?: boolean;
  noindex?: boolean;
  article?: { pubDate: Date; updatedDate?: Date | undefined; tags?: readonly string[] | undefined };
  /** Explicit hreflang alternates (absolute URLs) for a page translated at another slug. */
  alternates?: { hreflang: string; href: string }[];
  /** Path of this page's translation per locale: the language switch and hint go there. */
  translations?: Record<string, string>;
  /** Site path of this page's share image; the default card is used when omitted. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Opt into the print stylesheet: hide chrome, drop the banner, force the light palette. */
  printable?: boolean;
  /** The page H1 is in the pixel face (`PageHeader`, notes banner): preload its Latin file so the title does not flash a fallback. */
  pixelTitle?: boolean;
};

const { locale, printable = false, pixelTitle = false, translations, ...seo } = Astro.props;
const subscribeLink = showSubscribeLink({
  features: site.features,
  turnstileSiteKey: integrations.turnstileSiteKey,
  path: seo.path,
  printable,
});
const subscribeCta = showSubscribeCta({
  features: site.features,
  turnstileSiteKey: integrations.turnstileSiteKey,
  path: seo.path,
  printable,
});
// `Astro.slots.has` is true even when the slot's content is a conditional that rendered nothing,
// which would leave an empty sidebar column. Render the slot once and keep it only if it has content.
const asideHtml = Astro.slots.has('aside') ? (await Astro.slots.render('aside')).trim() : '';
const hasAside = asideHtml !== '';
const hasBanner = Astro.slots.has('banner');
const beaconToken = integrations.analyticsToken;
// Page CSS is inlined, so the browser only learns its font URLs after parsing it. Preloading the
// two Latin variable files (the only subsets Spanish and English text use) starts them with the
// HTML. Latin-ext, Vietnamese and Press Start 2P stay lazy via `unicode-range`/on-demand loading.
// The pixel Latin file (~12 KB) is added only by pages whose H1 uses it; the home preloads it itself.
const preloadedFonts = pixelTitle
  ? [spaceGroteskLatin, jetbrainsMonoLatin, pixelifySansLatin]
  : [spaceGroteskLatin, jetbrainsMonoLatin];
---

<html lang={locale} data-theme={DEFAULT_THEME} data-appearance={appearance}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preloadedFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <script is:inline set:html={themeBootScript(site.features.themeToggle)} />
    <Seo locale={locale} {...seo} />
    <slot name="head" />
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </head>
  <body class="min-h-dvh bg-page font-body text-text antialiased" data-printable={printable ? '' : undefined}>
    <a href="#main" class="sr-only z-50 rounded-control bg-button px-4 py-3 font-medium text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
      {t(locale, 'skip.content')}
    </a>
    <SiteNotice locale={locale} />
    <main id="main" tabindex="-1" class="outline-none">
      <div class="sticky top-0 z-40 mx-auto max-w-[1200px] px-3 md:px-4" data-site-chrome>
        <Navbar locale={locale} translations={translations} />
      </div>
      {hasBanner ? (
        <div class="-mt-18" data-banner-offset><slot name="banner" /></div>
      ) : (
        <slot name="banner" />
      )}
      <div class="mx-auto max-w-[1200px] px-3 md:px-4" data-content-container>
        <div class:list={['mt-4 grid gap-4', hasAside && 'lg:grid-cols-[minmax(0,1fr)_280px]']} data-main-grid>
          <div class="min-w-0 animate-fade-in-up [animation-delay:150ms]">
            <slot />
          </div>
          {hasAside && (
            <aside aria-label={t(locale, 'aside.label')} class="animate-fade-in-up [animation-delay:100ms]">
              <Fragment set:html={asideHtml} />
            </aside>
          )}
        </div>
      </div>
    </main>
    <div class="mx-auto max-w-[1200px] px-3 md:px-4" data-site-chrome>
      <Footer locale={locale} subscribeCta={subscribeCta} subscribeLink={subscribeLink} />
    </div>
    {site.features.languageHint && (
      <div class="mx-auto max-w-[1200px] px-3 md:px-4">
        <LanguageHint locale={locale} translations={translations} />
      </div>
    )}
    {site.features.backToTop && <BackToTop locale={locale} />}
    <slot name="floating" />
  </body>
</html>
