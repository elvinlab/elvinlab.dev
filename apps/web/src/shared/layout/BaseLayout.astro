---
/**
 * Page shell: head metadata, pre-paint theme script, skip link, navbar, content, footer and the
 * language hint. Pages pass an `aside` slot to get the design's `main | sidebar 280 px` grid and a
 * `banner` slot for the full-bleed banner above it.
 */
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/space-grotesk';
import '@/styles/global.css';

import { DEFAULT_THEME, THEME_BOOT_SCRIPT } from '@elvinlab/core';

import { integrations } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import Footer from '@/shared/layout/Footer.astro';
import Navbar from '@/shared/layout/Navbar.astro';
import SiteNotice from '@/shared/layout/SiteNotice.astro';
import Seo from '@/shared/seo/Seo.astro';
import LanguageHint from '@/shared/ui/LanguageHint.astro';

type Props = {
  locale: Locale;
  /** Route path without locale prefix, e.g. `/notes/`. */
  path: string;
  title?: string;
  description?: string;
  translated?: boolean;
  noindex?: boolean;
  article?: { pubDate: Date; updatedDate?: Date | undefined; tags?: readonly string[] | undefined };
  /** Explicit hreflang alternates (absolute URLs) for a page translated at another slug. */
  alternates?: { hreflang: string; href: string }[];
  /** Path of this page's translation per locale: the language switch and hint go there. */
  translations?: Record<string, string>;
  /** Site path of this page's share image; the default card is used when omitted. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Opt into the print stylesheet: hide chrome, drop the banner, force the light palette. */
  printable?: boolean;
};

const { locale, printable = false, translations, ...seo } = Astro.props;
const hasAside = Astro.slots.has('aside');
const hasBanner = Astro.slots.has('banner');
const beaconToken = integrations.analyticsToken;
---

<html lang={locale} data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <Seo locale={locale} {...seo} />
    <slot name="head" />
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </head>
  <body class="min-h-dvh bg-page font-body text-text antialiased" data-printable={printable ? '' : undefined}>
    <a href="#main" class="sr-only z-50 rounded-control bg-button px-4 py-3 font-medium text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
      {t(locale, 'skip.content')}
    </a>
    <SiteNotice locale={locale} />
    <main id="main" tabindex="-1" class="outline-none">
      <div class="sticky top-0 z-40 mx-auto max-w-[1200px] px-3 md:px-4" data-site-chrome>
        <Navbar locale={locale} translations={translations} />
      </div>
      {hasBanner ? (
        <div class="-mt-18" data-banner-offset><slot name="banner" /></div>
      ) : (
        <slot name="banner" />
      )}
      <div class="mx-auto max-w-[1200px] px-3 md:px-4" data-content-container>
        <div class:list={['mt-4 grid gap-4', hasAside && 'lg:grid-cols-[minmax(0,1fr)_280px]']} data-main-grid>
          <div class="min-w-0 animate-fade-in-up [animation-delay:150ms]">
            <slot />
          </div>
          {hasAside && (
            <aside aria-label={t(locale, 'aside.label')} class="animate-fade-in-up [animation-delay:100ms]">
              <slot name="aside" />
            </aside>
          )}
        </div>
      </div>
    </main>
    <div class="mx-auto max-w-[1200px] px-3 md:px-4" data-site-chrome>
      <Footer locale={locale} />
    </div>
    <div class="mx-auto max-w-[1200px] px-3 md:px-4">
      <LanguageHint locale={locale} translations={translations} />
    </div>
    <slot name="floating" />
  </body>
</html>
