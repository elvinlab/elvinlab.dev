---
/**
 * Site footer with the retro signature: the handle in Press Start 2P and a small static pink accent.
 */
import '@fontsource/press-start-2p/latin-400.css';

import { site } from '@/shared/config/index.ts';
import { type Locale, t } from '@/shared/i18n/index.ts';
import { externalLinkAttrs } from '@/shared/lib/external-link.ts';
import SubscribeBand from '@/shared/subscribe/SubscribeBand.astro';
import BrandMark from '@/shared/ui/BrandMark.astro';
import ExternalHint from '@/shared/ui/ExternalHint.astro';

type Props = { locale: Locale; subscribeCta?: boolean; subscribeLink?: boolean };

const { locale, subscribeCta = false, subscribeLink = false } = Astro.props;
const year = new Date().getFullYear();
// 44 px tall hit area; -mx-3 cancels the px-3 so the text keeps its column alignment under md.
const footerLink =
  '-mx-3 flex h-11 items-center rounded-control px-3 text-sm text-text-secondary transition-colors duration-150 hover:bg-card-hover hover:text-text md:mx-0';
---

<footer data-site-footer class="mt-16 animate-fade-in-up border-t border-dashed border-divider py-8 [animation-delay:250ms]">
  {subscribeCta && <SubscribeBand locale={locale} />}
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-3">
      <p class="flex items-center gap-2 font-retro text-xs leading-relaxed text-text-secondary">
        <BrandMark size={16} />{site.identity.handle}
      </p>
      <p class="text-sm text-muted">© {year} {site.identity.name}</p>
    </div>
    <div class="flex flex-col md:flex-row md:items-center md:justify-end md:gap-1">
      <a
        href={locale === 'es' ? '/privacy/' : '/en/privacy/'}
        class={footerLink}
      >
        {t(locale, 'footer.privacy')}
      </a>
      <a
        href={locale === 'es' ? '/terms/' : '/en/terms/'}
        class={footerLink}
      >
        {t(locale, 'footer.terms')}
      </a>
      {site.features.changelog && (
        <a
          href={locale === 'es' ? '/changelog/' : '/en/changelog/'}
          class={footerLink}
        >
          {t(locale, 'footer.changelog')}
        </a>
      )}
      {subscribeLink && (
        <a
          href={locale === 'es' ? '/subscribe/' : '/en/subscribe/'}
          class={footerLink}
        >
          {t(locale, 'footer.subscribe')}
        </a>
      )}
      {site.socials.length > 0 && (
        <ul aria-label={t(locale, 'footer.social')} class="-mx-3 flex flex-wrap gap-1 md:mx-0">
          {site.socials.map((social) => (
            <li>
              <a
                href={social.url}
                {...externalLinkAttrs(social.url, site.url, 'me')}
                class="flex h-11 items-center rounded-control px-3 text-sm text-text-secondary transition-colors duration-150 hover:bg-card-hover hover:text-text"
              >
                {social.label}<ExternalHint href={social.url} locale={locale} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</footer>
