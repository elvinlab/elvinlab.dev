---
/**
 * The glass button that grows or shrinks an expandable `Banner` (remembered per visitor), plus the
 * script that drives it. Kept apart from `Banner` and passed through its `toggle` slot, so the pages
 * whose banner never expands (every page but the home) do not ship the script or the button.
 */
import { type Locale, t } from '@/shared/i18n/index.ts';

type Props = { locale?: Locale };

const { locale = 'es' } = Astro.props;
---

<button
  type="button"
  data-banner-toggle
  aria-pressed="true"
  class="absolute right-3 bottom-3 z-10 flex h-9 items-center gap-1.5 rounded-pill bg-card/70 px-3 font-mono text-meta text-text-secondary backdrop-blur-md transition-colors duration-150 before:absolute before:-inset-1.5 hover:text-text"
  data-label-expand={t(locale, 'banner.expand')}
  data-label-collapse={t(locale, 'banner.collapse')}
  aria-label={t(locale, 'banner.collapse')}
>
  <svg data-icon-expand class="hidden" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3"></path></svg>
  <svg data-icon-collapse viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3m13-5h-3a2 2 0 0 0-2 2v3"></path></svg>
</button>

<script>
  const STORAGE_KEY = 'banner-expanded';
  const banner = document.querySelector<HTMLElement>('[data-banner]');
  const toggle = banner?.querySelector<HTMLButtonElement>('[data-banner-toggle]');

  if (banner && toggle) {
    const expandIcon = toggle.querySelector<SVGElement>('[data-icon-expand]');
    const collapseIcon = toggle.querySelector<SVGElement>('[data-icon-collapse]');

    const apply = (expanded: boolean): void => {
      banner.toggleAttribute('data-expanded', expanded);
      toggle.setAttribute('aria-pressed', String(expanded));
      toggle.setAttribute('aria-label', expanded ? toggle.dataset['labelCollapse'] ?? '' : toggle.dataset['labelExpand'] ?? '');
      expandIcon?.classList.toggle('hidden', expanded);
      collapseIcon?.classList.toggle('hidden', !expanded);
    };

    // Expanded by default; a visitor's saved choice ('0' collapsed / '1' expanded) wins.
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch {
      // Storage can be blocked; keep the default.
    }
    if (stored === '0') apply(false);

    toggle.addEventListener('click', () => {
      const expanded = !banner.hasAttribute('data-expanded');
      apply(expanded);
      try {
        localStorage.setItem(STORAGE_KEY, expanded ? '1' : '0');
      } catch {
        // Ignore storage failures; the toggle still works for this view.
      }
    });
  }
</script>
