---
/**
 * Sticky 72 px navbar card. Sections follow the feature flags; under `md` they collapse into a
 * disclosure menu. The language link and theme toggle stay visible at every width.
 */

import { getCollection } from 'astro:content';
import { localizePath, switchLocale } from '@elvinlab/core';

import { site } from '@/shared/config/index.ts';
import { LOCALES, type Locale, t } from '@/shared/i18n/index.ts';
import { isCurrent, isSingleLocaleRoute, navItems } from '@/shared/layout/nav.ts';
import { hasPublishedNotes } from '@/shared/lib/notes-helpers.ts';
import BackgroundPicker from '@/shared/ui/BackgroundPicker.astro';
import ThemeToggle from '@/shared/ui/ThemeToggle.astro';

type Props = { locale: Locale };

const { locale } = Astro.props;
const noteEntries = await getCollection('notes');
const notes = noteEntries.map((entry) => ({ slug: entry.id, data: entry.data }));
const routePath = switchLocale(Astro.url.pathname, LOCALES.defaultLocale, LOCALES);
const items = navItems(site.features, locale, hasPublishedNotes(notes)).map((item) => ({
  ...item,
  href: item.localize === false ? item.path : localizePath(item.path, locale, LOCALES),
  label: item.labelOverride ? t(locale, item.labelOverride as keyof typeof import('@/shared/i18n/index.ts').t) : t(locale, `nav.${item.key}`),
  current: isCurrent(routePath, item.path),
  hreflang: item.hreflang,
}));
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
// Notes exist in Spanish only: the switcher goes to the other locale's home, never to a missing URL.
const otherHref = isSingleLocaleRoute(routePath)
  ? localizePath('/', otherLocale, LOCALES)
  : switchLocale(Astro.url.pathname, otherLocale, LOCALES);
const linkClass =
  'flex h-11 items-center rounded-control px-3 font-medium transition-colors duration-150 hover:bg-card-hover aria-[current=page]:text-primary';
---

<header data-navbar class="animate-fade-in-up transition-transform duration-300 will-change-transform">
  <nav
    aria-label={t(locale, 'nav.label')}
    class="relative flex h-18 items-center gap-2 rounded-b-card bg-card/70 px-3 backdrop-blur-md md:px-4"
  >
    <a href={localizePath('/', locale, LOCALES)} class="mr-auto flex h-11 items-center rounded-control px-2 font-retro text-xs">
      <span class="text-muted">&gt;&nbsp;</span>{site.identity.handle}<span aria-hidden="true" class="ml-0.5 inline-block h-4 w-2 bg-pink align-[-2px]"></span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {items.map((item) => (
        <li><a href={item.href} class={linkClass} aria-current={item.current ? 'page' : undefined} hreflang={item.hreflang}>{item.label}</a></li>
      ))}
    </ul>

    <a
      href={otherHref}
      hreflang={otherLocale}
      lang={otherLocale}
      class="grid h-11 min-w-11 place-items-center rounded-control px-2 font-mono text-sm uppercase transition-colors duration-150 hover:bg-card-hover"
      aria-label={t(locale, 'language.switch')}
    >
      {otherLocale}
    </a>
    <ThemeToggle label={t(locale, 'theme.switch')} />
    <BackgroundPicker label={t(locale, 'background.switch')} />
    <button
      type="button"
      class="grid size-11 place-items-center rounded-control transition-colors duration-150 hover:bg-card-hover active:scale-96 md:hidden"
      aria-label={t(locale, 'nav.menu')}
      aria-expanded="false"
      aria-controls="nav-menu"
      data-nav-toggle
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>

    <ul id="nav-menu" hidden class="absolute inset-x-0 top-full mt-2 flex flex-col gap-1 rounded-card bg-card p-2 md:hidden">
      {items.map((item) => (
        <li><a href={item.href} class={linkClass} aria-current={item.current ? 'page' : undefined} hreflang={item.hreflang}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('nav-menu');

  const setOpen = (open: boolean): void => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(menu?.hidden === true));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<script>
  // Auto-hide the navbar on scroll down, reveal on scroll up (past a small threshold).
  const header = document.querySelector<HTMLElement>('[data-navbar]');
  if (header) {
    let last = window.scrollY;
    let ticking = false;
    const onScroll = (): void => {
      const y = window.scrollY;
      if (Math.abs(y - last) > 6) {
        const hide = y > last && y > 120;
        header.classList.toggle('-translate-y-full', hide);
        last = y;
      }
      ticking = false;
    };
    document.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    }, { passive: true });
  }
</script>
