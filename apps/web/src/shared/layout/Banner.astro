---
/**
 * Full-bleed banner: a static "lab paper" (fine grid, ruler ticks and registration crosses) over the
 * banner surface, with an optional animated background passed through the `background` slot. When `expandable`, a glass toggle lets
 * the visitor grow or shrink the background height (remembered per visitor); the content never moves.
 * The expand/collapse toggle (button and script, `BannerToggle.astro`) is passed through the `toggle` slot,
 * so only the page that expands its banner ships it. Every banner blends its bottom edge into the page through the same 120 px gradient, drawn by the
 * server-rendered markup and CSS only (no script), so the first paint of every page is already right.
 * A banner that never expands only carries its collapsed height. The heights below are what `full` shows; the `appearance` preset lowers them through the caps in
 * `calm-layout.css`, so a page never needs to know the preset.
 */
type Props = {
  height?: string;
  /** Height when expanded (defaults to the viewport). */
  expandedHeight?: string;
  /** Expanded height on touch and narrow screens, where the canvas is hidden or the hero is tall. */
  compactExpandedHeight?: string;
  /** The banner starts expanded (`data-expanded`); pair it with a `BannerToggle` in the `toggle` slot. */
  expandable?: boolean;
  /** Draw the lab-paper grid (home only: elsewhere it repeats until it reads as a template). */
  grid?: boolean;
};

const {
  height = '340px',
  expandedHeight = 'clamp(520px, 72vh, 640px)',
  compactExpandedHeight = expandedHeight,
  expandable = false,
  grid = false,
} = Astro.props;
---

<section
  class="banner relative isolate overflow-hidden bg-banner"
  style={expandable
    ? `--h-collapsed-base:${height};--h-expanded-base:${expandedHeight};--h-expanded-compact-base:${compactExpandedHeight}`
    : `--h-collapsed-base:${height}`}
  data-banner
  data-expanded={expandable ? true : undefined}
>
  {grid && <div class="banner-grid absolute inset-0 -z-20" aria-hidden="true"></div>}
  <slot name="background" />
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[120px] bg-gradient-to-b from-transparent to-page" data-banner-fade></div>
  <div data-banner-inner class="relative z-10 mx-auto flex h-full min-h-[inherit] max-w-[1200px] flex-col justify-end px-4">
    <slot />
  </div>

  <slot name="toggle" />
</section>

<style>
  /* The page asks for a height (`--*-base`, inline); the preset caps it (`calm-layout.css`). */
  .banner {
    --h-collapsed: min(var(--h-collapsed-base), var(--banner-page-cap));
    --h-expanded: min(var(--h-expanded-base), var(--banner-expanded-cap));
    --h-expanded-compact: min(var(--h-expanded-compact-base), var(--banner-expanded-compact-cap));
    min-height: var(--h-collapsed);
    transition: min-height 350ms ease;
  }
  [data-banner-inner] {
    padding-top: var(--banner-pad-top);
    padding-bottom: var(--banner-pad-bottom);
  }
  .banner[data-expanded] {
    min-height: var(--h-expanded);
  }
  /* The expand/collapse button sits 12 px from the bottom and is 36 px tall: on a phone the hero text
     reaches that corner, so keep the text clear of it (60 px). */
  @media (pointer: coarse), (max-width: 767px) {
    .banner:has([data-banner-toggle]) [data-banner-inner] {
      padding-bottom: max(var(--banner-pad-bottom), 3.75rem);
    }
  }
  /* Touch and phone-width screens: the canvas is hidden on coarse pointers, so a viewport-tall banner is
     mostly empty. A smaller floor lets the hero text size the banner (min-height never clips it). */
  @media (pointer: coarse), (max-width: 767px) {
    .banner[data-expanded] {
      min-height: var(--h-expanded-compact);
    }
  }
  /* Collapsed: hide the whole hero so the banner becomes a thin background band and the content
     below rises immediately. :global targets slotted content (a different Astro style scope). */
  .banner:not([data-expanded]) :global([data-hero-content]) {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .banner {
      transition: none;
    }
  }
  /* Lab paper: one ink, no animation, no glow. A minor line every 16 px, a stronger major line every
     80 px (every fifth), all in the text color at low alpha so the ink follows the theme. The mask fades the grid toward the edges but keeps a strip on the left for
     the ruler. Everything is decorative; the layer and its pseudo-elements are hidden in reading mode
     and print through the `.banner-grid` rules in `reading-mode.css` and `global.css`. */
  .banner-grid {
    --ink: color-mix(in srgb, var(--color-text) 32%, transparent);
    --minor: color-mix(in srgb, var(--color-text) 5%, transparent);
    --major: color-mix(in srgb, var(--color-text) 10%, transparent);
    --mark: linear-gradient(var(--ink), var(--ink));
    background:
      linear-gradient(var(--major) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(90deg, var(--major) 1px, transparent 1px) 0 0 / 80px 80px,
      linear-gradient(var(--minor) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--minor) 1px, transparent 1px) 0 0 / 16px 16px;
    mask-image:
      linear-gradient(#000, #000),
      radial-gradient(ellipse at center, #000 35%, rgb(0 0 0 / 0.4) 100%);
    mask-size: 12px 100%, auto;
    mask-position: left top, center;
    mask-repeat: no-repeat;
  }
  /* Light theme: dark ink on a pale ground reads about 30 % stronger behind the headline than light ink
     on the dark ground, so the grid lines (not the ruler ticks) get 30 % less alpha. */
  :global([data-theme='elvinlab-light']) .banner-grid {
    --minor: color-mix(in srgb, var(--color-text) 3.5%, transparent);
    --major: color-mix(in srgb, var(--color-text) 7%, transparent);
  }
  /* Vertical ruler on the left edge: a 6 px tick every 16 px, a 12 px tick every 80 px. */
  .banner-grid::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 12px;
    background:
      repeating-linear-gradient(var(--ink) 0 1px, transparent 1px 80px) left top / 12px 100% no-repeat,
      repeating-linear-gradient(var(--ink) 0 1px, transparent 1px 16px) left top / 6px 100% no-repeat;
  }
  /* Registration crosses (13 px, 1 px strokes) on major-grid intersections: upper left, upper right and
     mid right. The box is as wide as the last whole 80 px column, so right-anchored crosses land on
     the grid at any width. Without `round()` support the crosses are simply omitted. */
  @supports (width: round(down, 100px, 80px)) {
    .banner-grid::after {
      content: '';
      position: absolute;
      inset: 0 auto 0 0;
      width: round(down, 100%, 80px);
      background:
        var(--mark) left 234px top 80px / 13px 1px no-repeat,
        var(--mark) left 240px top 74px / 1px 13px no-repeat,
        var(--mark) right 153px top 80px / 13px 1px no-repeat,
        var(--mark) right 159px top 74px / 1px 13px no-repeat,
        var(--mark) right 73px top 240px / 13px 1px no-repeat,
        var(--mark) right 79px top 234px / 1px 13px no-repeat;
    }
    /* On a phone the hero text reaches the mid-right spot, so that cross is dropped there. */
    @media (max-width: 767px) {
      .banner-grid::after {
        background-size: 13px 1px, 1px 13px, 13px 1px, 1px 13px, 0 0, 0 0;
      }
    }
  }
</style>
