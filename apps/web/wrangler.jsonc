// Cloudflare Worker config. Secrets (Resend, Turnstile, contact addresses) are NOT here: they are
// set with `wrangler secret put` (see docs/CONFIGURATION.md, section 6.7).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elvinlab",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Prerendered pages: unknown paths get dist/404.html with a 404 status instead of an empty body.
  "assets": {
    "not_found_handling": "404-page"
  },
  // Per-location abuse limit, not an exact global email quota.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "MARKS_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Footprints on notes (docs/CONFIGURATION.md recipe 6.13). Created on 2026-10-05 with
  // `wrangler d1 create elvinlab-marks`; the table comes from migrations/0001_marks.sql. Without this
  // binding the marks Actions answer SERVICE_UNAVAILABLE and no button renders.
  "d1_databases": [
    {
      "binding": "MARKS_DB",
      "database_name": "elvinlab-marks",
      "database_id": "edd72441-6202-4d84-92af-8c3756020a83",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
